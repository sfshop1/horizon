    "custom_liquid_CyVqHk": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  .preorder-badge {\n    display: inline-block; /* fixed */\n    border-radius: 9999px;\n    font-size: 12px;\n    font-weight: 600;\n    padding: 4px 10px;\n    color: #fff;\n    background: #6b5436; /* your preorder color */\n    margin-left: .5rem;\n    vertical-align: middle;\n    white-space: nowrap;\n  }\n</style>\n\n<script>\n(() => {\n  // --- utils ---\n  const BADGE_ATTR = 'data-preorder-badge';\n\n  const fetchCart = () =>\n    fetch('/cart.js', { headers: { 'Accept': 'application/json' } }).then(r => r.json());\n\n  const isPreorderLine = (line) => {\n    const p = line?.properties || {};\n    const v = p._preorder ?? p['_preorder'];\n    return v === true || v === 'true';\n  };\n\n  // Build a Map of line.key -> boolean\n  const buildPreorderMap = (cart) => {\n    const map = new Map();\n    (cart.items || []).forEach(line => map.set(line.key, isPreorderLine(line)));\n    return map;\n  };\n\n  // Find the \"title-ish\" element inside a cart row to append our pill\n  const findTitleNodeInRow = (row) =>\n    row.querySelector('.cart-items__title, .cart-item__title, .cart-item__name, h3 a, h3, .cart-item__details a, a[href*=\"/products/\"]') || row;\n\n  // Clear any old badges in a given root (avoid duplicates on re-render)\n  const clearBadges = (root) => {\n    root.querySelectorAll('.preorder-badge[' + BADGE_ATTR + ']').forEach(el => el.remove());\n  };\n\n  // Render badges on the main cart table using data-key matching\n  const renderCartTableBadges = (root, preorderMap) => {\n    const rows = root.querySelectorAll('tr.cart-items__table-row[data-key]');\n    if (!rows.length) return;\n    rows.forEach(row => {\n      const key = row.getAttribute('data-key');\n      if (!key) return;\n\n      if (preorderMap.get(key)) {\n        const titleEl = findTitleNodeInRow(row);\n        if (!titleEl) return;\n\n        // Avoid duplicates if theme reuses nodes\n        if (titleEl.querySelector('.preorder-badge[' + BADGE_ATTR + ']')) return;\n\n        const badge = document.createElement('span');\n        badge.className = 'preorder-badge';\n        badge.setAttribute(BADGE_ATTR, 'true');\n        badge.textContent = 'Pre-order';\n        titleEl.appendChild(badge);\n      }\n    });\n  };\n\n  // Drawer support: many themes also put data-key on drawer lines.\n  const renderDrawerBadges = (drawerRoot, preorderMap) => {\n    if (!drawerRoot) return;\n    const drawerRows = drawerRoot.querySelectorAll('[data-key]');\n    drawerRows.forEach(row => {\n      const key = row.getAttribute('data-key');\n      if (!key) return;\n\n      if (preorderMap.get(key)) {\n        const titleEl =\n          row.querySelector('.cart-item__title, .cart-item__name, a[href*=\"/products/\"], .title, .name, h3') || row;\n\n        if (titleEl && !titleEl.querySelector('.preorder-badge[' + BADGE_ATTR + ']')) {\n          const badge = document.createElement('span');\n          badge.className = 'preorder-badge';\n          badge.setAttribute(BADGE_ATTR, 'true');\n          badge.textContent = 'Pre-order';\n          titleEl.appendChild(badge);\n        }\n      }\n    });\n  };\n\n  const applyBadges = async () => {\n    try {\n      const cart = await fetchCart();\n      const preorderMap = buildPreorderMap(cart);\n\n      const pageRoot = document; // main cart page\n      const drawerRoot = document.getElementById('CartDrawer')\n        || document.querySelector('[id*=\"CartDrawer\"], .cart-drawer, .drawer--cart')\n        || null;\n\n      clearBadges(pageRoot);\n      renderCartTableBadges(pageRoot, preorderMap);\n\n      if (drawerRoot) {\n        clearBadges(drawerRoot);\n        renderDrawerBadges(drawerRoot, preorderMap);\n      }\n    } catch (e) {\n      // swallow to avoid UX issues; open devtools to inspect if needed\n      console.warn('Preorder badge render error', e);\n    }\n  };\n\n  // run now + on DOM changes (your theme uses <cart-items-component/> which re-renders)\n  const start = () => {\n    applyBadges();\n\n    const targets = [\n      document.querySelector('cart-items-component') || document,\n      document.getElementById('CartDrawer')\n        || document.querySelector('[id*=\"CartDrawer\"], .cart-drawer, .drawer--cart')\n    ].filter(Boolean);\n\n    targets.forEach(t => {\n      const mo = new MutationObserver(() => applyBadges());\n      mo.observe(t, { childList: true, subtree: true });\n    });\n\n    ['cart:refresh','cart:updated','ajaxProduct:added','drawer:open','lineItem:updated','change']\n      .forEach(evt => document.addEventListener(evt, applyBadges, { passive: true }));\n  };\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', start);\n  } else {\n    start();\n  }\n})();\n</script>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
