    "custom_liquid_CyVqHk": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  .preorder-badge{\n    display:inline-block;border-radius:9999px;font-size:12px;font-weight:600;\n    padding:4px 10px;color:#fff;background:#6b5436;margin-left:.5rem;white-space:nowrap\n  }\n</style>\n\n<script>\n(() => {\n  const SF_TOKEN = '967cf6ccc67894215053bb3f8a0181b4'; // your Storefront API token\n  const SHOP = '{{ shop.permanent_domain | default: shop.url }}';\n  const GQL = `query GetLine($vid:ID!){\n    node(id:$vid){\n      ... on ProductVariant{\n        id\n        inventoryPolicy\n        product{ metafield(namespace:\"custom\",key:\"online_inventory\"){ value } }\n        components(first:50){\n          edges{ node{\n            quantity\n            productVariant{\n              id\n              product{ metafield(namespace:\"custom\",key:\"online_inventory\"){ value } }\n            }\n          } }\n        }\n      }\n    }\n  }`;\n\n  const fetchCart = () => fetch('/cart.js',{headers:{Accept:'application/json'}}).then(r=>r.json());\n  const gql = (vars) => fetch(`https://${SHOP}/api/2025-10/graphql.json`,{\n    method:'POST',\n    headers:{\n      'Content-Type':'application/json',\n      'Accept':'application/json',\n      'X-Shopify-Storefront-Access-Token':SF_TOKEN\n    },\n    body:JSON.stringify({query:GQL,variables:vars})\n  }).then(r=>r.json());\n\n  const parseNumberish = (v)=>{\n    if(v==null) return 0;\n    const n = Number(String(v).replace(/,/g,'').trim());\n    return Number.isFinite(n) ? n : 0;\n  };\n\n  const lineNeedsFlag = async (line)=>{\n    // Build variant GID from numeric id\n    const vidGID = `gid://shopify/ProductVariant/${line.variant_id}`;\n    const {data,errors} = await gql({vid:vidGID});\n    if(errors||!data?.node) return false;\n\n    const v = data.node;\n    const denyPolicySelected = (v.inventoryPolicy === 'DENY');\n\n    // Compute bundleStock = min over components of floor(onlineInv / qty)\n    let minCap = Infinity;\n    const edges = v.components?.edges || [];\n    if(!edges.length){\n      // If no components, treat like 0 stock (so it can be preorder) based on product metafield\n      const mf = v.product?.metafield?.value;\n      const inv = parseNumberish(mf);\n      minCap = isFinite(minCap) ? Math.min(minCap, inv>0?inv:0) : (inv>0?inv:0);\n    } else {\n      edges.forEach(e=>{\n        const qty = e.node.quantity>0?e.node.quantity:0;\n        const inv = parseNumberish(e.node.productVariant?.product?.metafield?.value);\n        const cap = qty>0 ? Math.floor(inv/qty) : 0;\n        minCap = Math.min(minCap, cap);\n      });\n    }\n\n    const bundleStock = (minCap===Infinity)?0:minCap;\n    const isPreorder = (!denyPolicySelected && bundleStock <= 0);\n\n    const hasFlag = !!(line.properties && ((line.properties._preorder ?? line.properties['_preorder']) === 'true' || (line.properties._preorder === true)));\n    return isPreorder && !hasFlag;\n  };\n\n  const updateLine = (line) =>\n    fetch('/cart/change.js',{\n      method:'POST',\n      headers:{'Content-Type':'application/json','Accept':'application/json'},\n      body:JSON.stringify({\n        id: line.key,\n        properties: Object.assign({}, line.properties || {}, { _preorder: 'true' })\n      })\n    }).then(r=>r.json());\n\n  const paintBadges = (cart)=>{\n    // Attach badge next to the title <p> inside each row\n    const rows = document.querySelectorAll('tr.cart-items__table-row[data-key]');\n    rows.forEach((row,idx)=>{\n      const key = row.getAttribute('data-key');\n      const line = cart.items.find(i=>i.key===key) || cart.items[idx];\n      if(!line) return;\n      const val = line.properties ? (line.properties._preorder ?? line.properties['_preorder']) : null;\n      if(val==='true' || val===true){\n        const anchor = row.querySelector('.cart-items__details p') || row.querySelector('.cart-items__title, h3, .cart-items__details') || row;\n        if(anchor && !anchor.querySelector('.preorder-badge')){\n          const tag = document.createElement('span');\n          tag.className='preorder-badge';\n          tag.textContent='Pre-order';\n          anchor.appendChild(tag);\n        }\n      }\n    });\n  };\n\n  const run = async ()=>{\n    let cart = await fetchCart();\n\n    // 1) Backfill any lines that should be preorder but lack the flag\n    const candidates = await Promise.all(cart.items.map(async line=>{\n      try { return await lineNeedsFlag(line) ? line : null; }\n      catch(e){ return null; }\n    }));\n\n    const toFix = candidates.filter(Boolean);\n    for(const line of toFix){\n      await updateLine(line);\n    }\n\n    // 2) Re-fetch cart and paint badges\n    cart = await fetchCart();\n    paintBadges(cart);\n\n    // 3) Re-apply on cart changes\n    const root = document.querySelector('cart-items-component') || document;\n    const mo = new MutationObserver(()=> fetchCart().then(paintBadges).catch(()=>{}));\n    mo.observe(root,{childList:true,subtree:true});\n    ['cart:updated','cart:refresh','lineItem:updated','change','submit']\n      .forEach(evt=>document.addEventListener(evt,()=>fetchCart().then(paintBadges).catch(()=>{}),{passive:true}));\n  };\n\n  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',run);} else {run();}\n})();\n</script>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
