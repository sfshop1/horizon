    "custom_liquid_CyVqHk": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{%- comment -%}\nStandalone Custom Liquid that adds a visible \"Pre-order\" badge to cart lines\nwhenever the line item has properties[_preorder] == \"true\".\nNo theme-file edits required.\n\nAssumptions:\n- Your add-to-cart flow sets properties[_preorder]=\"true\" when isPreorder = (!denyPolicySelected && bundleStock <= 0).\n- This block is present on pages where the cart page/drawer renders (e.g., added to Footer across templates).\n{%- endcomment -%}\n\n<style>\n  .preorder-badge {\n    display: inline-inline-block;\n    border-radius: 9999px;\n    font-size: 12px;\n    font-weight: 600;\n    padding: 4px 10px;\n    color: #fff;\n    background: #6b5436;\n    margin-left: .5rem;\n    vertical-align: middle;\n    white-space: nowrap;\n  }\n</style>\n\n<script>\n(function() {\n  // ---- Helpers ----\n  function fetchCart() {\n    return fetch('/cart.js', { headers: { 'Accept': 'application/json' } }).then(r => r.json());\n  }\n\n  function isPreorderLine(line) {\n    if (!line || !line.properties) return false;\n    // handle both _preorder and [\"_preorder\"]\n    const prop = line.properties._preorder ?? line.properties['_preorder'];\n    return prop === true || prop === 'true';\n  }\n\n  // Try to find “title” nodes for each cart line, in both cart page & drawer.\n  function findCartLineTitleNodes(root) {\n    const nodes = [];\n\n    // Common Dawn/OS2.0 cart page selectors:\n    root.querySelectorAll('.cart-items .cart-item, [data-cart-item]').forEach(itemEl => {\n      // Prefer a title element; fall back to the first link\n      const titleEl =\n        itemEl.querySelector('.cart-item__name, .cart-item__title, h3 a, h3, .cart-item__details a, a[href*=\"/products/\"]')\n        || itemEl;\n      nodes.push(titleEl);\n    });\n\n    // If we found nothing (theme variations), try a looser match\n    if (!nodes.length) {\n      root.querySelectorAll('.cart__items .cart__item, .drawer__cart-items .cart-item').forEach(itemEl => {\n        const titleEl = itemEl.querySelector('a, .title, .name, h3') || itemEl;\n        nodes.push(titleEl);\n      });\n    }\n\n    return nodes;\n  }\n\n  // Remove old badges to avoid duplicates\n  function clearOldBadges(root) {\n    root.querySelectorAll('.preorder-badge[data-preorder-badge]').forEach(el => el.remove());\n  }\n\n  // Attach badges by matching DOM order to cart.items order (works in most OS2.0 themes)\n  function renderBadges(root, cart) {\n    const titles = findCartLineTitleNodes(root);\n    if (!titles.length) return;\n\n    clearOldBadges(root);\n\n    // Map lines that are preorder by index\n    const preorderIndexes = [];\n    cart.items.forEach((line, idx) => {\n      if (isPreorderLine(line)) preorderIndexes.push(idx);\n    });\n    if (!preorderIndexes.length) return;\n\n    // Attach badges next to titles that line up by index\n    titles.forEach((titleEl, idx) => {\n      if (!preorderIndexes.includes(idx)) return;\n      const badge = document.createElement('span');\n      badge.className = 'preorder-badge';\n      badge.setAttribute('data-preorder-badge', 'true');\n      badge.textContent = 'Pre-order';\n\n      // Place badge sensibly after the title text/link\n      if (titleEl && titleEl.appendChild) {\n        titleEl.appendChild(badge);\n      }\n    });\n  }\n\n  // Observe the cart drawer/page for re-renders and re-apply badges\n  function attachObservers() {\n    const roots = [\n      document, // whole page (cart page case)\n      document.getElementById('CartDrawer') || document.querySelector('[id*=\"CartDrawer\"], .cart-drawer, .drawer--cart')\n    ].filter(Boolean);\n\n    roots.forEach(root => {\n      const apply = () => fetchCart().then(cart => renderBadges(root, cart)).catch(() => {});\n      apply();\n\n      // MutationObserver to catch drawer opens, quantity changes, etc.\n      const mo = new MutationObserver(() => apply());\n      mo.observe(root, { childList: true, subtree: true });\n\n      // Some themes dispatch custom events; listen if present (safe no-ops if not)\n      ['cart:refresh', 'cart:updated', 'ajaxProduct:added', 'drawer:open', 'lineItem:updated']\n        .forEach(evt => document.addEventListener(evt, apply, { passive: true }));\n    });\n  }\n\n  // Kick off after DOM is ready\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', attachObservers);\n  } else {\n    attachObservers();\n  }\n})();\n</script>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
