      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<section id=\"subscription-box-builder\" class=\"subscription-builder\">\n\n  <!-- Summary Bar -->\n  <div class=\"builder-summary\">\n\n    <div class=\"summary-stats\">\n      <div>Total Items: <span id=\"total-items\">0</span></div>\n      <div>Total Weight: <span id=\"total-weight\">0</span> lbs</div>\n    </div>\n  </div>\n\n  <!-- Items Table -->\n  <table class=\"builder-table\">\n    <thead>\n      <tr>\n        <th>Item</th>\n        <th>Description</th>\n        <th>Thickness</th>\n        <th>Approx. Weight</th>\n        <th colspan=\"2\">Qty</th>\n      </tr>\n    </thead>\n\n    <tbody>\n      {% for block in section.blocks %}\n      <tr class=\"builder-row\"\n          data-title=\"{{ block.settings.title }}\"\n          data-weight=\"{{ block.settings.weight }}\"\n          data-sku=\"{{ block.settings.sku }}\">\n        \n        <td>{{ block.settings.title }}</td>\n        <td>{{ block.settings.description }}</td>\n        <td>{{ block.settings.thickness }}</td>\n        <td>{{ block.settings.weight }} lb</td>\n\n        <td>\n          <button class=\"qty-minus\" data-index=\"{{ forloop.index0 }}\">-</button>\n        </td>\n        <td>\n          <span class=\"qty-display\" id=\"qty-{{ forloop.index0 }}\">0</span>\n          <button class=\"qty-plus\" data-index=\"{{ forloop.index0 }}\">+</button>\n        </td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <!-- Hidden JSON Output -->\n  <textarea id=\"bundle-json\" style=\"display:none;\"></textarea>\n\n  <!-- Complete Subscription Button -->\n  <button id=\"complete-subscription\" class=\"complete-btn\">\n    Complete Subscription\n  </button>\n\n</section>\n\n{{ 'subscription-builder.js' | asset_url | script_tag }}\n\n<style>\n.subscription-builder {\n  max-width: 900px;\n  margin: auto;\n  font-family: sans-serif;\n}\n\n.builder-summary {\n  background: #f7f7f7;\n  padding: 20px;\n  margin-bottom: 20px;\n  border-radius: 6px;\n}\n\n.summary-stats {\n  display: flex;\n  gap: 40px;\n  margin-top: 10px;\n  font-size: 18px;\n}\n\n.builder-table {\n  width: 100%;\n  border-collapse: collapse;\n}\n\n.builder-table th,\n.builder-table td {\n  padding: 10px;\n  border-bottom: 1px solid #ddd;\n}\n\n.qty-minus,\n.qty-plus {\n  padding: 6px 10px;\n  background: #eee;\n  border: 1px solid #ccc;\n  cursor: pointer;\n}\n\n.complete-btn {\n  margin-top: 20px;\n  padding: 14px 20px;\n  background: #6B5436;\n  color: white;\n  border: none;\n  cursor: pointer;\n  font-size: 18px;\n  border-radius: 6px;\n}\n</style>\n\n{{ 'subscription-builder.js' | asset_url | script_tag }}",
