              "settings": {
                "custom_liquid": "{%- comment %}SMART SHIPPING / PICKUP MESSAGE – VARIANT WEIGHT EDITION{% endcomment -%}\n\n{%- assign total_inventory = 0 -%}\n{%- assign has_deny_policy = false -%}\n{%- assign selected_variant = product.selected_or_first_available_variant -%}\n\n{%- for variant in product.variants -%}\n  {%- assign qty = variant.inventory_quantity | default: 0 -%}\n  {%- assign total_inventory = total_inventory | plus: qty -%}\n  {%- if variant.inventory_policy == 'deny' and qty <= 0 -%}\n    {%- assign has_deny_policy = true -%}\n  {%- endif -%}\n{%- endfor -%}\n\n{%- if has_deny_policy == false -%}\n  {%- comment %}Convert selected variant weight from grams to lbs{% endcomment -%}\n  {%- assign variant_weight_lbs = selected_variant.weight | divided_by: 453.592 | round: 1 -%}\n\n  <div style=\"\n    margin: 3px 0;\n    padding: 10px 5px;\n    background: #f8fff0;\n    border-left: 6px solid #4caf50;\n    border-radius: 0 12px 12px 0;\n    font-size: 14px;\n    font-weight: 600;\n    color: #2e7d32;\n    text-align: center;\n    line-height: 1.5;\n  \">\n    {%- if variant_weight_lbs < 145 -%}\n      Farm Pickup, Local Delivery & Shipping Available\n    {%- else -%}\n      Farm Pickup & Local Delivery Available\n    {%- endif -%}\n  </div>\n{%- endif -%}"
