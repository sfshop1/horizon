                  "name": "t:names.custom_liquid",
                  "settings": {
                    "custom_liquid": "{% assign total_inventory = 0 %}\n{% assign has_deny_policy = false %}\n\n{% for variant in product.variants %}\n  {% assign variant_qty = variant.inventory_quantity | default: 0 %}\n  {% assign total_inventory = total_inventory | plus: variant_qty %}\n  {% if variant.inventory_policy == 'deny' and variant_qty <= 0 %}\n    {% assign has_deny_policy = true %}\n  {% endif %}\n{% endfor %}\n\n<style>\n  .product-stock-badge {\n    display: inline-block;\n    border-radius: 9999px;\n    font-size: 13px;\n    font-weight: 600;\n    padding: 4px 10px;\n    color: #fff;\n    letter-spacing: 0.02em;\n    margin: 5px 0;\n  }\n  .product-stock-badge.soldout   { background-color: #9e9e9e; }\n  .product-stock-badge.preorder  { background-color: #6b5436; }\n  .product-stock-badge.available { background-color: #4caf50; }\n  .product-stock-badge.shop-msg  { background-color: #dc3545; }\n</style>\n\n<div style=\"margin:0px 0; line-height:1.8;\">\n\n  {% if has_deny_policy %}\n    <div><span class=\"product-stock-badge soldout\">Sold Out</span></div>\n\n  {% elsif total_inventory <= 0 %}\n    <div><span class=\"product-stock-badge preorder\">Pre-Order</span></div>\n    \n    {%- assign shop_message = shop.metafields.custom.pre_order_message.value -%}\n    {%- if shop_message != blank -%}\n      <div><span class=\"product-stock-badge shop-msg\">{{ shop_message }}</span></div>\n    {%- endif -%}\n    \n  {% else %}\n    <div><span class=\"product-stock-badge available\">Remaining: {{ total_inventory }}</span></div>\n  {% endif %}\n\n</div>"
