                  "settings": {
                    "custom_liquid": "{% assign total_inventory = 0 %}\n{% assign has_deny_policy = false %}\n\n{% for variant in product.variants %}\n  {% assign online_qty = product.metafields.custom.online_inventory.value | default: 0 %}\n  {% assign total_inventory = total_inventory | plus: online_qty %}\n  {% if variant.inventory_policy == 'deny' and online_qty <= 0 %}\n    {% assign has_deny_policy = true %}\n  {% endif %}\n{% endfor %}\n\n<style>\n  .product-stock-badge {\n    display: inline-block;\n    border-radius: 9999px; /* pill shape */\n    font-size: 12px;\n    font-weight: 600;\n    padding: 4px 10px;\n    color: #fff;\n    letter-spacing: 0.02em;\n    vertical-align: middle;\n  }\n  .product-stock-badge.soldout { background-color: #9e9e9e; }\n  .product-stock-badge.preorder { background-color: #6b5436; }\n  .product-stock-badge.available { background-color: #4caf50; }\n</style>\n\n<div id=\"stock-badge-container\">\n  {% if has_deny_policy %}\n    <span class=\"product-stock-badge soldout\">Sold Out</span>\n  {% elsif total_inventory <= 0 %}\n    <span class=\"product-stock-badge preorder\">Pre-order</span>\n  {% else %}\n    <span class=\"product-stock-badge available\">Remaining: {{ total_inventory }}</span>\n  {% endif %}\n</div>"
