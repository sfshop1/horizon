                  "blocks": {
                    "custom_liquid_Utif7C": {
                      "type": "custom-liquid",
                      "name": "t:names.custom_liquid",
                      "settings": {
                        "custom_liquid": "{% assign current_variant = product.selected_or_first_available_variant %}\n\n<div id=\"bundle-components\" class=\"product__bundle sb-product-description\">\n  <p>Loading bundle contents...</p>\n</div>\n\n<style>\n  /* Base list */\n  .bundle-list {\n    list-style: none;\n    padding: 0;\n    margin: 0 0 15px 0;\n  }\n\n  /* Each row */\n  .bundle-item {\n    position: relative;         /* for hover card anchoring */\n    display: flex;\n    align-items: center;        /* centers weight/desc with quantity horizontally */\n    gap: 10px;\n    padding: 8px 0;\n    margin: 0;\n    border-bottom: 2px solid #e0e0e0;\n    letter-spacing: 0.04em;\n    line-height: 1.4;\n    font-size: 14px;            /* base text size */\n  }\n  .bundle-item:last-child { border-bottom: none; }\n\n  /* Quantity (2px bigger than base) */\n  .bundle-quantity {\n    font-size: 16px;            /* base (14) + 2px */\n    font-weight: 700;\n    min-width: 28px;\n    text-align: right;\n  }\n\n  /* Small “×” symbol styling */\n  .bundle-mult {\n    font-size: 15px;\n    font-weight: 600;\n    margin: 0 2px;\n  }\n\n  /* The right side (weight + product/variant) */\n  .bundle-body {\n    display: flex;\n    align-items: center;        /* keeps text vertically centered with qty */\n    flex-wrap: wrap;\n    gap: 6px;\n  }\n\n  .variant-weight {\n    font-size: 14px;\n    opacity: 0.85;\n  }\n\n  .bundle-product,\n  .bundle-variant {\n    font-size: 14px;\n  }\n\n  .bundle-divider {\n    border-top: 1px solid #ccc;\n    margin: 8px 0 12px 0;\n  }\n\n  /* Totals (+1px bigger than base) */\n  .bundle-total-quantity,\n  .total-weight {\n    font-size: 15px;            /* base (14) + 1px */\n    font-weight: 600;\n    margin: 4px 0;\n    letter-spacing: 0.04em;\n    line-height: 1.3;\n  }\n\n  /* Inline quick details trigger */\n  .bundle-details-link {\n    font-size: 13px;\n    font-weight: 600;\n    text-decoration: underline;\n    cursor: pointer;\n    opacity: .85;\n  }\n\n  /* Hover card (desktop) */\n  .hovercard {\n    position: absolute;\n    left: 38px;                 /* offset a bit after the quantity column */\n    top: 100%;\n    margin-top: 8px;\n    width: min(360px, 92vw);\n    background: #fff;\n    color: #222;\n    border: 1px solid #e6e6e6;\n    border-radius: 10px;\n    box-shadow: 0 12px 32px rgba(0,0,0,.18);\n    padding: 10px;\n    display: none;              /* default hidden */\n    z-index: 20;\n  }\n  .hovercard.open { display: block; }\n\n  .hovercard-content {\n    display: grid;\n    grid-template-columns: 64px 1fr;\n    gap: 10px;\n    align-items: center;\n  }\n  .hovercard-thumb {\n    width: 64px;\n    height: 64px;\n    object-fit: cover;\n    border-radius: 8px;\n    border: 1px solid #eee;\n  }\n  .hovercard-title {\n    font-weight: 700;\n    margin: 0 0 4px 0;\n    font-size: 14px;\n  }\n  .hovercard-desc {\n    font-size: 13px;\n    line-height: 1.4;\n    max-height: 5.2em;          /* ~4 lines */\n    overflow: hidden;\n  }\n\n  /* Quick-view dialog (mobile & desktop) */\n  .bundle-quickview dialog {\n    width: min(720px, 92vw);\n    border: none;\n    padding: 0;\n    border-radius: 12px;\n    box-shadow: 0 24px 64px rgba(0,0,0,.25);\n  }\n  .quickview-header {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    padding: 14px 16px;\n    border-bottom: 1px solid #eee;\n  }\n  .quickview-body {\n    display: grid;\n    grid-template-columns: 180px 1fr;\n    gap: 16px;\n    padding: 16px;\n  }\n  .quickview-img {\n    width: 180px;\n    height: 180px;\n    object-fit: cover;\n    border-radius: 10px;\n    border: 1px solid #eee;\n  }\n  .quickview-actions {\n    display: flex;\n    justify-content: space-between;\n    gap: 12px;\n    padding: 14px 16px 16px;\n    border-top: 1px solid #eee;\n  }\n  .quickview-close {\n    background: transparent;\n    border: none;\n    font-weight: 700;\n    cursor: pointer;\n  }\n\n  /* Desktop: show hovercard on hover/focus-within; Mobile: disabled via media query */\n  @media (hover: hover) and (pointer: fine) {\n    .bundle-item:hover .hovercard,\n    .bundle-item:focus-within .hovercard { display: block; }\n  }\n\n  /* On coarse pointers (mobile), keep hovercards hidden; rely on dialog instead */\n  @media (hover: none), (pointer: coarse) {\n    .hovercard { display: none !important; }\n  }\n</style>\n\n<!-- One-time quick-view dialog (used on mobile and when clicking “Details”) -->\n<div class=\"bundle-quickview\">\n  <dialog id=\"bundleQuickView\">\n    <div class=\"quickview-header\">\n      <strong id=\"qvTitle\"></strong>\n      <button class=\"quickview-close\" aria-label=\"Close\" onclick=\"document.getElementById('bundleQuickView').close()\">✕</button>\n    </div>\n    <div class=\"quickview-body\">\n      <img id=\"qvImg\" class=\"quickview-img\" alt=\"\">\n      <div id=\"qvDesc\"></div>\n    </div>\n    <div class=\"quickview-actions\">\n      <a id=\"qvProductLink\" href=\"#\" target=\"_blank\" rel=\"noopener\">View product</a>\n      <button class=\"quickview-close\" onclick=\"document.getElementById('bundleQuickView').close()\">Close</button>\n    </div>\n  </dialog>\n</div>\n\n<script>\n  const storefrontAccessToken = '967cf6ccc67894215053bb3f8a0181b4';\n  const shopDomain = {{ shop.permanent_domain | json }};\n  const variantId = {{ current_variant.admin_graphql_api_id | json }};\n\n  // ---- Helpers to keep JS safe when inserting dynamic strings ----\n  const stripScripts = (html) =>\n    (html || '').replace(/<script\\b[^>]*>[\\s\\S]*?<\\/script>/gi, '');\n\n  const escapeForTemplate = (s) =>\n    (s || '')\n      .replace(/`/g, '&#96;')                     // break out of template literal\n      .replace(/<\\/script/gi, '<\\\\/script>');    // avoid closing the <script> tag\n\n  const escapeForAttr = (s) =>\n    (s || '')\n      .replace(/&/g, '&amp;')\n      .replace(/\"/g, '&quot;')\n      .replace(/</g, '&lt;')\n      .replace(/>/g, '&gt;');\n\n  const stripTagsToText = (html) =>\n    (html || '').replace(/<[^>]*>/g, ' ').replace(/\\s+/g, ' ').trim();\n\n  // Weight conversion\n  const toLbs = (w, u) => {\n    if (!w) return 0;\n    switch (u || 'GRAMS') {\n      case 'GRAMS':     return w / 453.592;\n      case 'KILOGRAMS': return w * 2.20462;\n      case 'POUNDS':    return w;\n      case 'OUNCES':    return w / 16;\n      default:          return 0;\n    }\n  };\n\n  const query = `\n    query GetBundleComponents($variantId: ID!) {\n      node(id: $variantId) {\n        ... on ProductVariant {\n          id\n          title\n          product { title handle }\n          components(first: 20) {\n            edges {\n              node {\n                quantity\n                productVariant {\n                  id\n                  title\n                  image { url altText }\n                  product {\n                    title\n                    handle\n                    featuredImage { url altText }\n                    descriptionHtml\n                  }\n                  weight\n                  weightUnit\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  `;\n\n  async function fetchBundleComponents() {\n    const container = document.getElementById('bundle-components');\n\n    try {\n      const res = await fetch(`https://${shopDomain}/api/2025-10/graphql.json`, {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'Accept': 'application/json',\n          'X-Shopify-Storefront-Access-Token': storefrontAccessToken\n        },\n        body: JSON.stringify({ query, variables: { variantId } })\n      });\n\n      if (!res.ok) {\n        const t = await res.text();\n        container.innerHTML = `<p class=\"bundle-error\">Error ${res.status}: ${escapeForAttr(t).slice(0,160)}…</p>`;\n        return;\n      }\n\n      const { data, errors } = await res.json();\n      if (errors && errors.length) {\n        console.error('GraphQL errors:', errors);\n        container.innerHTML = `<p class=\"bundle-error\">GraphQL errors (see console).</p>`;\n        return;\n      }\n\n      const variant = data?.node;\n      if (!variant) {\n        container.innerHTML = `<p class=\"bundle-error\">No variant found (check sales channel publication).</p>`;\n        return;\n      }\n\n      const components = variant.components?.edges || [];\n      let totalQuantity = 0;\n      let totalWeightLb = 0;\n      let html = '';\n\n      if (components.length > 0) {\n        html += '<ul class=\"bundle-list\">';\n\n        components.slice().reverse().forEach(edge => {\n          const comp = edge.node;\n          const pv = comp.productVariant;\n          const qty = comp.quantity || 0;\n\n          totalQuantity += qty;\n\n          const lbEach = toLbs(pv?.weight, pv?.weightUnit);\n          totalWeightLb += (lbEach * qty) || 0;\n          const weightText = lbEach >= 1 ? `${Math.round(lbEach)}lb` : `${Math.round(lbEach * 16)}oz`;\n\n          const imgUrl = pv?.image?.url || pv?.product?.featuredImage?.url || '';\n          const imgAlt = pv?.image?.altText || pv?.product?.featuredImage?.altText || pv?.product?.title || '';\n\n          // Sanitize description for different contexts\n          const descRaw = stripScripts(pv?.product?.descriptionHtml || '');\n          const descForModalHTML = escapeForTemplate(descRaw);                 // safe to inject into template literal, then into innerHTML later\n          const descForHoverText = escapeForAttr(stripTagsToText(descRaw));    // plain text for hover card\n          const productUrl = pv?.product?.handle ? `/products/${pv.product.handle}` : '#';\n          const variantIdShort = (pv?.id || '').split('/').pop();\n\n          const titleFull = `${pv?.product?.title || ''}${pv?.title && pv.title !== 'Default Title' ? ` — ${pv.title}` : ''}`;\n\n          html += `\n            <li class=\"bundle-item\" data-variant-id=\"${variantIdShort}\">\n              <span class=\"bundle-quantity\">${qty}</span>\n              <span class=\"bundle-mult\">×</span>\n              <div class=\"bundle-body\">\n                <span class=\"bundle-product\">${escapeForTemplate(pv?.product?.title || 'Item')}</span>\n                ${pv?.title && pv.title !== 'Default Title' ? `<span class=\"bundle-variant\">(${escapeForTemplate(pv.title)})</span>` : ''}\n                <span class=\"variant-weight\">(${weightText})</span>\n                <span class=\"bundle-details-link\"\n                      data-title=\"${escapeForAttr(titleFull)}\"\n                      data-img=\"${escapeForAttr(imgUrl)}\"\n                      data-imgalt=\"${escapeForAttr(imgAlt)}\"\n                      data-desc=\"${escapeForAttr(descForModalHTML)}\"\n                      data-url=\"${escapeForAttr(productUrl)}\">\n                  Details\n                </span>\n              </div>\n\n              <!-- Hover card (desktop uses plain text excerpt) -->\n              <div class=\"hovercard\" role=\"tooltip\" aria-hidden=\"true\">\n                <div class=\"hovercard-content\">\n                  ${imgUrl\n                    ? `<img class=\"hovercard-thumb\" src=\"${escapeForTemplate(imgUrl)}\" alt=\"${escapeForTemplate(imgAlt)}\">`\n                    : `<div class=\"hovercard-thumb\" style=\"display:grid;place-items:center;background:#fafafa;color:#888;\">—</div>`}\n                  <div>\n                    <div class=\"hovercard-title\">${escapeForTemplate(titleFull)}</div>\n                    <div class=\"hovercard-desc\">${descForHoverText || 'No description.'}</div>\n                  </div>\n                </div>\n              </div>\n            </li>`;\n        });\n\n        html += '</ul><div class=\"bundle-divider\"></div>';\n        if (totalQuantity > 0) html += `<p class=\"bundle-total-quantity\">Total Quantity: ${totalQuantity} items</p>`;\n        html += `<p class=\"total-weight\">Total Approx Weight: ${Math.round(totalWeightLb)}lb</p>`;\n      } else {\n        html += '<p>No bundle components found for this variant.</p>';\n      }\n\n      container.innerHTML = html;\n\n      // Open modal from \"Details\"\n      container.addEventListener('click', (e) => {\n        const btn = e.target.closest('.bundle-details-link');\n        if (!btn) return;\n\n        const dlg = document.getElementById('bundleQuickView');\n        document.getElementById('qvTitle').textContent = btn.dataset.title || '';\n        const img = document.getElementById('qvImg');\n        img.src = btn.dataset.img || '';\n        img.alt = btn.dataset.imgalt || '';\n        // We stored sanitized HTML in data-desc (escaped to be attribute-safe),\n        // now decode entities for innerHTML.\n        const descDecoded = (btn.dataset.desc || '')\n          .replace(/&quot;/g, '\"')\n          .replace(/&lt;/g, '<')\n          .replace(/&gt;/g, '>')\n          .replace(/&amp;/g, '&');\n        document.getElementById('qvDesc').innerHTML = descDecoded || '<p>No description.</p>';\n\n        const link = document.getElementById('qvProductLink');\n        link.href = btn.dataset.url || '#';\n\n        if (typeof dlg.showModal === 'function') dlg.showModal();\n        else dlg.setAttribute('open', 'true');\n      });\n\n      // Keyboard: show hovercard on focus\n      container.addEventListener('focusin', (e) => {\n        const li = e.target.closest('.bundle-item'); if (!li) return;\n        const card = li.querySelector('.hovercard'); if (card) card.classList.add('open');\n      });\n      container.addEventListener('focusout', (e) => {\n        const li = e.target.closest('.bundle-item'); if (!li) return;\n        const card = li.querySelector('.hovercard'); if (card) card.classList.remove('open');\n      });\n\n    } catch (err) {\n      console.error('Bundle fetch error:', err);\n      container.innerHTML = `<p class=\"bundle-error\">Error loading bundle contents: ${String(err.message || err)}</p>`;\n    }\n  }\n\n  fetchBundleComponents();\n</script>"
                      },
