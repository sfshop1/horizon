                "accordion_row_QLiT4G": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "BUNDLE INCLUDES",
                    "open_by_default": true,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "custom_liquid_Utif7C": {
                      "type": "custom-liquid",
                      "name": "t:names.custom_liquid",
                      "settings": {
                        "custom_liquid": "{% comment %}\n  Liquid snippet to fetch and display Shopify Bundles components using Storefront GraphQL API.\n  Replicates Simple Bundles features: bundle list, total quantity, and total weight (in lb/oz).\n  Components are displayed in reverse order to match cart display.\n  Replace 'your_storefront_access_token_here' with your actual Storefront API access token.\n  Add to your theme's product template (e.g., sections/main-product.liquid or templates/product.liquid).\n{% endcomment %}\n\n{% assign current_variant = product.selected_or_first_available_variant %}\n\n<div id=\"bundle-components\" class=\"product__bundle sb-product-description\">\n  <p>Loading bundle contents...</p>\n</div>\n\n<style>\n  .bundle-list {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n  }\n  .bundle-item {\n    margin: 0;\n    padding: 8px 0;\n    border-bottom: 1px solid #e0e0e0;\n  }\n  .bundle-item:last-child {\n    border-bottom: none;\n  }\n  .bundle-divider {\n    border-top: 1px solid #ccc;\n    margin: 15px 0;\n  }\n</style>\n\n<script>\n  const storefrontAccessToken = '967cf6ccc67894215053bb3f8a0181b4';\n  const shopDomain = '{{ shop.permanent_domain | default: shop.url }}';\n  const variantId = 'gid://shopify/ProductVariant/{{ current_variant.id }}';\n\n  const query = `\n    query GetBundleComponents($variantId: ID!) {\n      node(id: $variantId) {\n        ... on ProductVariant {\n          id\n          title\n          product {\n            title\n            handle\n          }\n          components(first: 10) {\n            edges {\n              node {\n                quantity\n                productVariant {\n                  id\n                  title\n                  weight\n                  weightUnit\n                  product {\n                    title\n                    handle\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  `;\n\n  async function fetchBundleComponents() {\n    try {\n      console.log('Fetching bundle components for variant:', variantId);\n      console.log('API URL:', `https://${shopDomain}/api/2025-10/graphql.json`);\n      console.log('Using token:', storefrontAccessToken ? 'Token present' : 'Token missing');\n      const response = await fetch(`https://${shopDomain}/api/2025-10/graphql.json`, {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'Accept': 'application/json',\n          'X-Shopify-Storefront-Access-Token': storefrontAccessToken\n        },\n        body: JSON.stringify({\n          query,\n          variables: { variantId }\n        })\n      });\n\n      console.log('Response status:', response.status);\n      if (!response.ok) {\n        const errorText = await response.text();\n        throw new Error(`Network response was not ok: ${response.status} - ${errorText}`);\n      }\n\n      const { data, errors } = await response.json();\n      console.log('Raw response:', { data, errors });\n      if (errors) {\n        console.error('GraphQL errors:', JSON.stringify(errors, null, 2));\n        throw new Error('GraphQL query failed');\n      }\n\n      const variant = data.node;\n      if (!variant) {\n        document.getElementById('bundle-components').innerHTML = '<p>No variant found for ID: ' + variantId + '</p>';\n        return;\n      }\n\n      const components = variant.components?.edges || [];\n      let totalQuantity = 0;\n      let totalWeightLb = 0;\n      let html = '';\n      if (components.length > 0) {\n        html += '<ul class=\"bundle-list\">';\n        // Reverse components to match cart order\n        components.slice().reverse().forEach(edge => {\n          const comp = edge.node;\n          const pv = comp.productVariant;\n          const variantId = pv.id.split('/').pop();\n          totalQuantity += comp.quantity;\n\n          // Convert weight to pounds\n          let weightInLb = 0;\n          if (pv.weight && pv.weight > 0) {\n            const unit = pv.weightUnit || 'GRAMS';\n            switch (unit) {\n              case 'GRAMS':\n                weightInLb = pv.weight / 453.592;\n                break;\n              case 'KILOGRAMS':\n                weightInLb = pv.weight * 2.20462;\n                break;\n              case 'POUNDS':\n                weightInLb = pv.weight;\n                break;\n              case 'OUNCES':\n                weightInLb = pv.weight / 16;\n                break;\n              default:\n                weightInLb = 0;\n            }\n            totalWeightLb += weightInLb * comp.quantity;\n          }\n\n          // Display individual weight\n          const weightText = weightInLb >= 1 \n            ? `${Math.round(weightInLb)}lb` \n            : `${Math.round(weightInLb * 16)}oz`;\n\n          html += `\n            <li class=\"bundle-item\" data-variant-id=\"${variantId}\" data-weight-lb=\"${weightInLb * comp.quantity}\">\n              <span class=\"bundle-quantity\">${comp.quantity}</span>\n              (<span class=\"variant-weight\">${weightText}</span>)\n              <span class=\"bundle-product\">${pv.product.title}</span>\n              ${pv.title !== 'Default Title' ? `(${pv.title})` : ''}\n            </li>`;\n        });\n        html += '</ul>';\n        html += '<div class=\"bundle-divider\"></div>';\n        if (totalQuantity > 0) {\n          html += `<div class=\"bundle-total-quantity\"><strong>Total Quantity:</strong> ${totalQuantity} items</div>`;\n        }\n        html += `<p class=\"total-weight\" style=\"font-weight: bold\">Total Approx Weight: ${Math.round(totalWeightLb)}lb</p>`;\n      } // No components: empty html (hides everything)\n\n      document.getElementById('bundle-components').innerHTML = html;\n    } catch (error) {\n      console.error('Error fetching bundle components:', error);\n      document.getElementById('bundle-components').innerHTML = '<p>Error loading bundle contents: ' + error.message + '. Check console for details.</p>';\n    }\n  }\n\n  fetchBundleComponents();\n</script>"
                      },
