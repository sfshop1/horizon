              "blocks": {
                "accordion_row_QLiT4G": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "BUNDLE INCLUDES",
                    "open_by_default": true,
                    "icon": "check_box",
                    "width": 20
                  },
                  "blocks": {
                    "custom_liquid_Utif7C": {
                      "type": "custom-liquid",
                      "name": "t:names.custom_liquid",
                      "settings": {
                        "custom_liquid": "{% assign current_variant = product.selected_or_first_available_variant %}\n\n<div id=\"bundle-components\" class=\"product__bundle sb-product-description\">\n  <p>Loading bundle contents...</p>\n</div>\n\n<style>\n  /* Base list */\n  .bundle-list { list-style: none; padding: 0; margin: 0 0 15px 0; }\n  .bundle-item {\n    display: flex; align-items: center; gap: 10px;\n    padding: 8px 0; margin: 0; border-bottom: 2px solid #e0e0e0;\n    letter-spacing: 0.04em; line-height: 1.4; font-size: 14px;\n  }\n  .bundle-item:last-child { border-bottom: none; }\n  .bundle-quantity { font-size: 16px; font-weight: 700; min-width: 28px; text-align: right; }\n  .bundle-mult { font-size: 15px; font-weight: 600; margin: 0 2px; }\n  .bundle-body { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }\n  .variant-weight { font-size: 14px; opacity: 0.85; }\n  .bundle-product, .bundle-variant { font-size: 14px; }\n  .bundle-divider { border-top: 1px solid #ccc; margin: 8px 0 12px 0; }\n  .bundle-total-quantity, .total-weight { font-size: 15px; font-weight: 600; margin: 4px 0; letter-spacing: 0.04em; line-height: 1.3; }\n</style>\n\n<script>\n  // Reuse your existing token/domain\n  const storefrontAccessToken = '967cf6ccc67894215053bb3f8a0181b4';\n  const shopDomain = '{{ shop.permanent_domain | default: shop.url }}';\n  const variantId = 'gid://shopify/ProductVariant/{{ current_variant.id }}';\n\n  // Helper: render the stock badge (replaces the Liquid fallback for bundles)\n  function setStockBadge({ status, count }) {\n    const container = document.getElementById('stock-badge-container');\n    if (!container) return;\n    let html = '';\n    if (status === 'soldout') {\n      html = '<span class=\"product-stock-badge soldout\">Sold Out</span>';\n    } else if (status === 'preorder') {\n      html = '<span class=\"product-stock-badge preorder\">Pre-order</span>';\n    } else {\n      html = `<span class=\"product-stock-badge available\">Remaining: ${count}</span>`;\n    }\n    container.innerHTML = html;\n  }\n\n  // GraphQL query:\n  // - Pulls bundle components for the selected variant\n  // - For each component, fetches the component product's custom.online_inventory metafield\n  // - Also fetches variant inventoryPolicy if you want to treat \"deny\" as hard sold-out\n  const query = `\n    query GetBundleComponents($variantId: ID!) {\n      node(id: $variantId) {\n        ... on ProductVariant {\n          id\n          title\n          inventoryPolicy\n          product { title handle }\n          components(first: 50) {\n            edges {\n              node {\n                quantity\n                productVariant {\n                  id\n                  title\n                  weight\n                  weightUnit\n                  inventoryPolicy\n                  product {\n                    title\n                    handle\n                    metafield(namespace: \"custom\", key: \"online_inventory\") {\n                      value\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  `;\n\n  async function fetchStorefront(query, variables) {\n    const response = await fetch(`https://${shopDomain}/api/2025-10/graphql.json`, {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json',\n        'Accept': 'application/json',\n        'X-Shopify-Storefront-Access-Token': storefrontAccessToken\n      },\n      body: JSON.stringify({ query, variables })\n    });\n    if (!response.ok) {\n      const t = await response.text();\n      throw new Error(`HTTP ${response.status}: ${t}`);\n    }\n    const json = await response.json();\n    if (json.errors) throw new Error(JSON.stringify(json.errors));\n    return json.data;\n  }\n\n  function parseNumber(str) {\n    if (str === null || str === undefined) return 0;\n    const n = Number(String(str).replace(/[^0-9.-]/g, ''));\n    return Number.isFinite(n) ? n : 0;\n  }\n\n  async function renderBundleAndInventory() {\n    const mount = document.getElementById('bundle-components');\n    try {\n      const data = await fetchStorefront(query, { variantId });\n      const variant = data?.node;\n      const compEdges = variant?.components?.edges || [];\n\n      // If no components, let your original Liquid badge stand and bail.\n      if (compEdges.length === 0) {\n        if (mount) mount.innerHTML = '';\n        return;\n      }\n\n      // Build the UI + compute total weight\n      let totalQuantity = 0;\n      let totalWeightLb = 0;\n      let html = '<ul class=\"bundle-list\">';\n\n      // Compute bundle availability (min across components)\n      let bundleMin = Infinity;\n      let anyDenyAndZero = false;\n\n      compEdges.slice().reverse().forEach(({ node }) => {\n        const compQty = Number(node.quantity) || 0;\n        const pv = node.productVariant;\n        const variantIdShort = pv.id.split('/').pop();\n\n        totalQuantity += compQty;\n\n        // Weight conversion (unchanged)\n        let weightInLb = 0;\n        if (pv.weight && pv.weight > 0) {\n          const unit = pv.weightUnit || 'GRAMS';\n          switch (unit) {\n            case 'GRAMS':     weightInLb = pv.weight / 453.592; break;\n            case 'KILOGRAMS': weightInLb = pv.weight * 2.20462; break;\n            case 'POUNDS':    weightInLb = pv.weight; break;\n            case 'OUNCES':    weightInLb = pv.weight / 16; break;\n            default:          weightInLb = 0;\n          }\n          totalWeightLb += weightInLb * compQty;\n        }\n        const weightText = weightInLb >= 1 ? `${Math.round(weightInLb)}lb` : `${Math.round(weightInLb * 16)}oz`;\n\n        // ***** NEW: read custom.online_inventory from the component's PRODUCT *****\n        const onlineInvStr = pv.product?.metafield?.value;\n        const onlineInv = parseNumber(onlineInvStr); // treat missing as 0\n\n        // How many bundles could this component support by itself?\n        const componentBundles = compQty > 0 ? Math.floor(onlineInv / compQty) : 0;\n        bundleMin = Math.min(bundleMin, componentBundles);\n\n        // (Optional) treat hard deny + zero as Sold Out (instead of Pre-order)\n        if ((pv.inventoryPolicy === 'DENY' || pv.inventoryPolicy === 'deny') && onlineInv <= 0) {\n          anyDenyAndZero = true;\n        }\n\n        html += `\n          <li class=\"bundle-item\" data-variant-id=\"${variantIdShort}\" data-weight-lb=\"${(weightInLb * compQty) || 0}\">\n            <span class=\"bundle-quantity\">${compQty}</span>\n            <span class=\"bundle-mult\">×</span>\n            <div class=\"bundle-body\">\n              <span class=\"bundle-product\">${pv.product.title}</span>\n              ${pv.title !== 'Default Title' ? `<span class=\"bundle-variant\">(${pv.title})</span>` : ''}\n              <span class=\"variant-weight\">(${weightText})</span>\n              <span class=\"variant-weight\">• In stock for bundle calc: ${onlineInv}</span>\n            </div>\n          </li>`;\n      });\n\n      html += '</ul><div class=\"bundle-divider\"></div>';\n      if (totalQuantity > 0) html += `<p class=\"bundle-total-quantity\">Total Quantity: ${totalQuantity} items</p>`;\n      html += `<p class=\"total-weight\">Total Approx Weight: ${Math.round(totalWeightLb)}lb</p>`;\n\n      // Write the list UI\n      if (mount) mount.innerHTML = html;\n\n      // ***** NEW: Override the badge for bundles *****\n      if (!Number.isFinite(bundleMin)) bundleMin = 0;\n      if (bundleMin <= 0) {\n        // Choose one of these two behaviors:\n        // 1) If you want strict sold-out when a component is deny+zero:\n        // if (anyDenyAndZero) setStockBadge({ status: 'soldout' });\n        // else set to preorder:\n        setStockBadge({ status: 'preorder' });\n      } else {\n        setStockBadge({ status: 'available', count: bundleMin });\n      }\n    } catch (err) {\n      console.error('Error building bundle info:', err);\n      if (mount) {\n        mount.innerHTML = `<p>Error loading bundle contents: ${err.message}. Check console for details.</p>`;\n      }\n      // If it errors, your original Liquid badge remains visible.\n    }\n  }\n\n  renderBundleAndInventory();\n</script>"
                      },
