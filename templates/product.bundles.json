              "blocks": {
                "accordion_row_QLiT4G": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "BUNDLE INCLUDES",
                    "open_by_default": true,
                    "icon": "check_box",
                    "width": 20
                  },
                  "blocks": {
                    "custom_liquid_Utif7C": {
                      "type": "custom-liquid",
                      "name": "t:names.custom_liquid",
                      "settings": {
                        "custom_liquid": "{% assign current_variant = product.selected_or_first_available_variant %}\n\n<div id=\"bundle-components\" class=\"product__bundle sb-product-description\">\n  <p>Loading bundle contents...</p>\n</div>\n\n<style>\n  /* Base list */\n  .bundle-list {\n    list-style: none;\n    padding: 0;\n    margin: 0 0 15px 0;\n  }\n\n  /* Each row */\n  .bundle-item {\n    display: flex;\n    align-items: center;       /* centers weight/desc with quantity horizontally */\n    gap: 10px;\n    padding: 8px 0;\n    margin: 0;\n    border-bottom: 2px solid #e0e0e0;\n    letter-spacing: 0.04em;\n    line-height: 1.4;\n    font-size: 14px;           /* base text size */\n  }\n  .bundle-item:last-child { border-bottom: none; }\n\n  /* Quantity (2px bigger than base) */\n  .bundle-quantity {\n    font-size: 16px;           /* base (14) + 2px */\n    font-weight: 700;\n    min-width: 28px;\n    text-align: right;\n  }\n\n  /* Small “×” symbol styling */\n  .bundle-mult {\n    font-size: 15px;\n    font-weight: 600;\n    margin: 0 2px;\n  }\n\n  /* The right side (weight + product/variant) */\n  .bundle-body {\n    display: flex;\n    align-items: center;       /* keeps text vertically centered with qty */\n    flex-wrap: wrap;\n    gap: 6px;\n  }\n\n  .variant-weight {\n    font-size: 14px;\n    opacity: 0.85;\n  }\n\n  .bundle-product,\n  .bundle-variant {\n    font-size: 14px;\n  }\n\n  .bundle-divider {\n    border-top: 1px solid #ccc;\n    margin: 8px 0 12px 0;\n  }\n\n  /* Totals (+1px bigger than before) */\n  .bundle-total-quantity,\n  .total-weight {\n    font-size: 15px;           /* base (14) + 1px */\n    font-weight: 600;\n    margin: 4px 0;\n    letter-spacing: 0.04em;\n    line-height: 1.3;\n  }\n</style>\n\n<script>\n  const storefrontAccessToken = '967cf6ccc67894215053bb3f8a0181b4';\n  const shopDomain = '{{ shop.permanent_domain | default: shop.url }}';\n  const variantId = 'gid://shopify/ProductVariant/{{ current_variant.id }}';\n\n  const query = `\n    query GetBundleComponents($variantId: ID!) {\n      node(id: $variantId) {\n        ... on ProductVariant {\n          id\n          title\n          product { title handle }\n          components(first: 10) {\n            edges {\n              node {\n                quantity\n                productVariant {\n                  id\n                  title\n                  weight\n                  weightUnit\n                  product { title handle }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  `;\n\n  async function fetchBundleComponents() {\n    try {\n      const response = await fetch(`https://${shopDomain}/api/2025-10/graphql.json`, {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'Accept': 'application/json',\n          'X-Shopify-Storefront-Access-Token': storefrontAccessToken\n        },\n        body: JSON.stringify({ query, variables: { variantId } })\n      });\n\n      if (!response.ok) {\n        const errorText = await response.text();\n        throw new Error(`Network response was not ok: ${response.status} - ${errorText}`);\n      }\n\n      const { data, errors } = await response.json();\n      if (errors) throw new Error('GraphQL query failed');\n\n      const variant = data.node;\n      if (!variant) {\n        document.getElementById('bundle-components').innerHTML = '<p>No variant found for ID: ' + variantId + '</p>';\n        return;\n      }\n\n      const components = variant.components?.edges || [];\n      let totalQuantity = 0;\n      let totalWeightLb = 0;\n      let html = '';\n\n      if (components.length > 0) {\n        html += '<ul class=\"bundle-list\">';\n        components.slice().reverse().forEach(edge => {\n          const comp = edge.node;\n          const pv = comp.productVariant;\n          const variantIdShort = pv.id.split('/').pop();\n          totalQuantity += comp.quantity;\n\n          // Convert weight to pounds\n          let weightInLb = 0;\n          if (pv.weight && pv.weight > 0) {\n            const unit = pv.weightUnit || 'GRAMS';\n            switch (unit) {\n              case 'GRAMS':    weightInLb = pv.weight / 453.592; break;\n              case 'KILOGRAMS':weightInLb = pv.weight * 2.20462; break;\n              case 'POUNDS':   weightInLb = pv.weight; break;\n              case 'OUNCES':   weightInLb = pv.weight / 16; break;\n              default:         weightInLb = 0;\n            }\n            totalWeightLb += weightInLb * comp.quantity;\n          }\n\n          const weightText = weightInLb >= 1\n            ? `${Math.round(weightInLb)}lb`\n            : `${Math.round(weightInLb * 16)}oz`;\n\n          html += `\n            <li class=\"bundle-item\" data-variant-id=\"${variantIdShort}\" data-weight-lb=\"${(weightInLb * comp.quantity) || 0}\">\n              <span class=\"bundle-quantity\">${comp.quantity}</span>\n              <span class=\"bundle-mult\">×</span>\n              <div class=\"bundle-body\">\n                <span class=\"bundle-product\">${pv.product.title}</span>\n                ${pv.title !== 'Default Title' ? `<span class=\"bundle-variant\">(${pv.title})</span>` : ''}\n                <span class=\"variant-weight\">(${weightText})</span>\n              </div>\n            </li>`;\n        });\n\n        html += '</ul>';\n        html += '<div class=\"bundle-divider\"></div>';\n        if (totalQuantity > 0) {\n          html += `<p class=\"bundle-total-quantity\">Total Quantity: ${totalQuantity} items</p>`;\n        }\n        html += `<p class=\"total-weight\">Total Approx Weight: ${Math.round(totalWeightLb)}lb</p>`;\n      }\n\n      document.getElementById('bundle-components').innerHTML = html;\n    } catch (error) {\n      console.error('Error fetching bundle components:', error);\n      document.getElementById('bundle-components').innerHTML = '<p>Error loading bundle contents: ' + error.message + '. Check console for details.</p>';\n    }\n  }\n\n  fetchBundleComponents();\n</script>"
                      },
