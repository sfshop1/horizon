                "accordion_row_QLiT4G": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "BUNDLE INCLUDES",
                    "open_by_default": true,
                    "icon": "check_box",
                    "width": 20
                  },
                  "blocks": {
                    "custom_liquid_Utif7C": {
                      "type": "custom-liquid",
                      "name": "t:names.custom_liquid",
                      "settings": {
                        "custom_liquid": "{%- assign current_variant = product.selected_or_first_available_variant -%}\n\n<div id=\"bundle-components\" class=\"product__bundle sb-product-description\">\n  <p>Loading bundle contents...</p>\n</div>\n\n<style>\n  .bundle-list { list-style: none; padding: 0; margin: 0 0 15px 0; }\n  .bundle-item { display: flex; align-items: center; gap: 10px; padding: 8px 0; margin: 0; border-bottom: 2px solid #e0e0e0; letter-spacing: 0.04em; line-height: 1.4; font-size: 14px; }\n  .bundle-item:last-child { border-bottom: none; }\n  .bundle-quantity { font-size: 16px; font-weight: 700; min-width: 28px; text-align: right; }\n  .bundle-mult { font-size: 15px; font-weight: 600; margin: 0 2px; }\n  .bundle-body { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }\n  .variant-weight { font-size: 14px; opacity: 0.85; }\n  .bundle-product, .bundle-variant { font-size: 14px; }\n  .bundle-divider { border-top: 1px solid #ccc; margin: 8px 0 12px 0; }\n  .bundle-total-quantity, .total-weight { font-size: 15px; font-weight: 600; margin: 4px 0; letter-spacing: 0.04em; line-height: 1.3; }\n\n  /* Per-line info */\n  .variant-bundle-cap { font-size: 13px; opacity: 0.85; }\n\n  /* Badge styles */\n  .product-stock-badge {\n    display: inline-block;\n    border-radius: 9999px; /* pill */\n    font-size: 12px;\n    font-weight: 600;\n    padding: 4px 10px;\n    color: #fff;\n    letter-spacing: 0.02em;\n    vertical-align: middle;\n    margin-top: 6px;\n  }\n  .product-stock-badge.soldout { background-color: #9e9e9e; }\n  .product-stock-badge.preorder { background-color: #6b5436; }\n  .product-stock-badge.available { background-color: #4caf50; }\n</style>\n\n<script>\n  /* ====== CONFIG FROM LIQUID ====== */\n  const storefrontAccessToken = '967cf6ccc67894215053bb3f8a0181b4'; // consider moving to a theme setting\n  const shopDomain = '{{ shop.permanent_domain | default: shop.url }}';\n  const currentVariantNumericId = {{ current_variant.id | json }};\n  const variantIdGID = 'gid://shopify/ProductVariant/{{ current_variant.id }}';\n\n  // Bring the selected variant's deny policy from Liquid into JS\n  const denyPolicySelected = {% if current_variant and current_variant.inventory_policy == 'deny' %}true{% else %}false{% endif %};\n\n  /* ====== GRAPHQL QUERY (Storefront API) ====== */\n  const query = `\n    query GetBundleComponents($variantId: ID!) {\n      node(id: $variantId) {\n        ... on ProductVariant {\n          id\n          title\n          product { title handle }\n          components(first: 50) {\n            edges {\n              node {\n                quantity\n                productVariant {\n                  id\n                  title\n                  weight\n                  weightUnit\n                  product {\n                    title\n                    handle\n                    metafield(namespace: \"custom\", key: \"online_inventory\") {\n                      value\n                      type\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  `;\n\n  /* ====== HELPERS ====== */\n\n  // Find the correct product form for this variant and ensure our hidden input exists inside it.\n  function ensurePreorderHiddenInput() {\n    // Most OS 2.0 themes have one or more product forms. We scope to the form that posts our current variant id.\n    const idSelector = `form[action*=\"/cart/add\"] input[name=\"id\"][value=\"${currentVariantNumericId}\"]`;\n    const form = document.querySelector(idSelector)?.closest('form');\n    if (!form) return null;\n\n    let input = form.querySelector('input[name=\"properties[_preorder]\"]');\n    if (!input) {\n      input = document.createElement('input');\n      input.type = 'hidden';\n      input.name = 'properties[_preorder]';\n      input.value = '';\n      input.setAttribute('data-preorder-flag', 'true');\n      form.appendChild(input);\n    }\n    return { form, input };\n  }\n\n  // Set (or clear) the preorder flag value\n  function setPreorderFlag(isPreorder) {\n    const nodes = ensurePreorderHiddenInput();\n    if (!nodes) return;\n    nodes.input.value = isPreorder ? 'true' : '';\n  }\n\n  // Attach a submit hook to keep the flag in sync at the last moment\n  function attachFormSubmitHook(computeIsPreorder) {\n    const nodes = ensurePreorderHiddenInput();\n    if (!nodes) return;\n    // Avoid duplicate listeners\n    if (!nodes.form.hasAttribute('data-preorder-hook')) {\n      nodes.form.setAttribute('data-preorder-hook', 'true');\n      nodes.form.addEventListener('submit', () => {\n        const currentIsPre = computeIsPreorder();\n        setPreorderFlag(currentIsPre);\n      });\n    }\n  }\n\n  // Parsing helpers\n  function parseNumberish(value) {\n    if (value == null) return null;\n    const raw = String(value).trim();\n    const n = Number(raw.replace(/,/g, ''));\n    if (Number.isFinite(n)) return n;\n    const int = parseInt(raw, 10);\n    return Number.isFinite(int) ? int : null;\n  }\n\n  function toPounds(weight, unit) {\n    if (!weight || weight <= 0) return 0;\n    switch (unit || 'GRAMS') {\n      case 'GRAMS': return weight / 453.592;\n      case 'KILOGRAMS': return weight * 2.20462;\n      case 'POUNDS': return weight;\n      case 'OUNCES': return weight / 16;\n      default: return 0;\n    }\n  }\n\n  /* ====== MAIN RENDER ====== */\n  async function fetchBundleComponents() {\n    try {\n      const response = await fetch(`https://${shopDomain}/api/2025-10/graphql.json`, {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'Accept': 'application/json',\n          'X-Shopify-Storefront-Access-Token': storefrontAccessToken\n        },\n        body: JSON.stringify({ query, variables: { variantId: variantIdGID } })\n      });\n\n      if (!response.ok) {\n        const errorText = await response.text();\n        throw new Error(`Network response was not ok: ${response.status} - ${errorText}`);\n      }\n\n      const { data, errors } = await response.json();\n      if (errors) throw new Error('GraphQL query failed');\n\n      const variant = data.node;\n      if (!variant) {\n        document.getElementById('bundle-components').innerHTML = '<p>No variant found for ID: ' + variantIdGID + '</p>';\n        return;\n      }\n\n      const components = variant.components?.edges || [];\n      let totalQuantity = 0;\n      let totalWeightLb = 0;\n      let bundleStockMin = Infinity; // min over per-line capacities\n\n      let html = '';\n\n      if (components.length > 0) {\n        html += '<ul class=\"bundle-list\">';\n\n        components.slice().reverse().forEach(edge => {\n          const comp = edge.node;\n          const pv = comp.productVariant;\n\n          const requiredQty = comp.quantity > 0 ? comp.quantity : 0;\n          totalQuantity += requiredQty;\n\n          // product-level custom.online_inventory\n          const mf = pv.product?.metafield;\n          const onlineInv = parseNumberish(mf?.value);\n          const onlineInvForCalc = (onlineInv == null || Number.isNaN(onlineInv)) ? 0 : onlineInv;\n\n          // per-line capacity floor(onlineInv / requiredQty)\n          const lineBundleCap = requiredQty > 0 ? Math.floor(onlineInvForCalc / requiredQty) : 0;\n          bundleStockMin = Math.min(bundleStockMin, lineBundleCap);\n\n          // weight calc\n          const weightInLbEach = toPounds(pv.weight, pv.weightUnit);\n          totalWeightLb += weightInLbEach * requiredQty;\n\n          const weightText = weightInLbEach >= 1 ? `${Math.round(weightInLbEach)}lb` : `${Math.round(weightInLbEach * 16)}oz`;\n          const variantIdShort = pv.id.split('/').pop();\n\n          html += `\n            <li class=\"bundle-item\" data-variant-id=\"${variantIdShort}\" data-weight-lb=\"${(weightInLbEach * requiredQty) || 0}\">\n              <span class=\"bundle-quantity\">${requiredQty}</span>\n              <span class=\"bundle-mult\">×</span>\n              <div class=\"bundle-body\">\n                <span class=\"bundle-product\">${pv.product.title}</span>\n                ${pv.title !== 'Default Title' ? `<span class=\"bundle-variant\">(${pv.title})</span>` : ''}\n                <span class=\"variant-weight\">(${weightText})</span>\n              </div>\n            </li>`;\n        });\n\n        html += '</ul>';\n        html += '<div class=\"bundle-divider\"></div>';\n        if (totalQuantity > 0) {\n          html += `<p class=\"bundle-total-quantity\">Total Quantity: ${totalQuantity} items</p>`;\n        }\n        html += `<p class=\"total-weight\">Total Approx Weight: ${Math.round(totalWeightLb)}lb</p>`;\n\n        // final bundle stock (min across components)\n        const bundleStock = (bundleStockMin === Infinity) ? 0 : bundleStockMin;\n\n        // ----- BADGE -----\n        let badgeHtml = '';\n        if (denyPolicySelected && bundleStock <= 0) {\n          badgeHtml = `<span class=\"product-stock-badge soldout\">Sold Out</span>`;\n        } else if (bundleStock <= 0) {\n          badgeHtml = `<span class=\"product-stock-badge preorder\">Pre-order</span>`;\n        } else {\n          badgeHtml = `<span class=\"product-stock-badge available\">Remaining: ${bundleStock}</span>`;\n        }\n        html += badgeHtml;\n\n        // ===== KEY PART: compute the SAME boolean and set the hidden property =====\n        const computeIsPreorder = () => (!denyPolicySelected && bundleStock <= 0);\n        const isPreorder = computeIsPreorder();\n        setPreorderFlag(isPreorder);\n        attachFormSubmitHook(computeIsPreorder);\n        // ============================================\n\n      } else {\n        html += '<p>No bundle components found.</p>';\n      }\n\n      document.getElementById('bundle-components').innerHTML = html;\n    } catch (error) {\n      console.error('Error fetching bundle components:', error);\n      document.getElementById('bundle-components').innerHTML = '<p>Error loading bundle contents: ' + error.message + '. Check console for details.</p>';\n    }\n  }\n\n  fetchBundleComponents();\n\n  /* If your theme swaps variants on change, you may want to re-run the logic.\n     Example hook (uncomment and adapt as needed):\n  document.addEventListener('change', (e) => {\n    if (e.target.matches('select[name=\"options[]\"], input[name^=\"options\"]')) {\n      // Optionally refetch components for the newly selected variant\n      // and update the preorder flag accordingly.\n    }\n  });\n  */\n</script>"
                      },
