{% doc %}
  @prompt
    Create a product badge that displays stock level for products. The badge should show the total inventory quantity across all variants when stock is available, and display "Pre-order" when stock is 0 or less. Style it with a green background when in stock and red background for pre-order. Position it absolutely in the top-left corner of the product image.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign total_inventory = 0
  for variant in product.variants
    if variant.inventory_management == 'shopify'
      assign total_inventory = total_inventory | plus: variant.inventory_quantity
    endif
  endfor
%}

{% style %}
  .ai-stock-badge-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.vertical_position }}px;
    left: {{ block.settings.horizontal_position }}px;
    z-index: 10;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    border-radius: {{ block.settings.border_radius }}px;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    line-height: 1.2;
    text-align: center;
    transition: all 0.3s ease;
  }

  .ai-stock-badge-{{ ai_gen_id }}--in-stock {
    background-color: {{ block.settings.in_stock_bg_color }};
    color: {{ block.settings.in_stock_text_color }};
  }

  .ai-stock-badge-{{ ai_gen_id }}--pre-order {
    background-color: {{ block.settings.pre_order_bg_color }};
    color: {{ block.settings.pre_order_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-stock-badge-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
      padding: {{ block.settings.padding_vertical | times: 0.8 }}px {{ block.settings.padding_horizontal | times: 0.8 }}px;
    }
  }
{% endstyle %}

{% if total_inventory > 0 %}
  <div class="ai-stock-badge-{{ ai_gen_id }} ai-stock-badge-{{ ai_gen_id }}--in-stock" {{ block.shopify_attributes }}>
    {% if block.settings.show_stock_count %}
      {{ total_inventory }} {{ block.settings.in_stock_label }}
    {% else %}
      {{ block.settings.in_stock_label }}
    {% endif %}
  </div>
{% else %}
  <div class="ai-stock-badge-{{ ai_gen_id }} ai-stock-badge-{{ ai_gen_id }}--pre-order" {{ block.shopify_attributes }}>
    {{ block.settings.pre_order_label }}
  </div>
{% endif %}

{% schema %}
{
  "name": "Product stock badge",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Position"
    },
    {
      "type": "range",
      "id": "horizontal_position",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Horizontal position",
      "default": 10
    },
    {
      "type": "range",
      "id": "vertical_position",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Vertical position",
      "default": 10
    },
    {
      "type": "header",
      "content": "In stock"
    },
    {
      "type": "checkbox",
      "id": "show_stock_count",
      "label": "Show stock count",
      "default": true
    },
    {
      "type": "text",
      "id": "in_stock_label",
      "label": "Label",
      "default": "In Stock"
    },
    {
      "type": "color",
      "id": "in_stock_bg_color",
      "label": "Background",
      "default": "#28a745"
    },
    {
      "type": "color",
      "id": "in_stock_text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Pre-order"
    },
    {
      "type": "text",
      "id": "pre_order_label",
      "label": "Label",
      "default": "Pre-order"
    },
    {
      "type": "color",
      "id": "pre_order_bg_color",
      "label": "Background",
      "default": "#dc3545"
    },
    {
      "type": "color",
      "id": "pre_order_text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 2,
      "max": 16,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 6
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Product stock badge"
    }
  ]
}
{% endschema %}
