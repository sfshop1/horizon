{% doc %}
  @prompt
    can you add to my three column layout and make it so the width of the columns depends on the page set to fit or fill?  
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-column-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-three-column-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-three-column-grid-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.column_gap }}px;
    flex-wrap: wrap;
  }

  .ai-three-column-grid-{{ ai_gen_id }}.ai-column-width-fill-{{ ai_gen_id }} {
    justify-content: space-between;
  }

  .ai-three-column-grid-{{ ai_gen_id }}.ai-column-width-fit-{{ ai_gen_id }} {
    justify-content: flex-start;
  }

  .ai-three-column-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-three-column-grid-{{ ai_gen_id }}.ai-column-width-fill-{{ ai_gen_id }} .ai-three-column-item-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-three-column-grid-{{ ai_gen_id }}.ai-column-width-fit-{{ ai_gen_id }} .ai-three-column-item-{{ ai_gen_id }} {
    flex: 0 1 auto;
  }

  .ai-three-column-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-three-column-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-three-column-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-three-column-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-three-column-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-three-column-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    text-align: {{ block.settings.text_alignment }};
  }

  @media screen and (max-width: 768px) {
    .ai-three-column-grid-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-three-column-item-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-three-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-three-column-container-{{ ai_gen_id }}">
    <div class="ai-three-column-grid-{{ ai_gen_id }} ai-column-width-{{ block.settings.column_width }}-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'column_' | append: i | append: '_image'
          assign heading_key = 'column_' | append: i | append: '_heading'
          assign text_key = 'column_' | append: i | append: '_text'
          
          assign column_image = block.settings[image_key]
          assign column_heading = block.settings[heading_key]
          assign column_text = block.settings[text_key]
        %}
        
        <div class="ai-three-column-item-{{ ai_gen_id }}">
          {% if column_image %}
            <div class="ai-three-column-image-wrapper-{{ ai_gen_id }}">
              <img
                src="{{ column_image | image_url: width: 600 }}"
                alt="{{ column_image.alt | escape }}"
                loading="lazy"
                width="{{ column_image.width }}"
                height="{{ column_image.height }}"
                class="ai-three-column-image-{{ ai_gen_id }}"
              >
            </div>
          {% else %}
            <div class="ai-three-column-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
          
          {% if column_heading != blank %}
            <h3 class="ai-three-column-heading-{{ ai_gen_id }}">{{ column_heading }}</h3>
          {% endif %}
          
          {% if column_text != blank %}
            <div class="ai-three-column-text-{{ ai_gen_id }}">{{ column_text }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Three column layout",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "column_width",
      "label": "Column width",
      "options": [
        {
          "value": "fill",
          "label": "Fill (equal width)"
        },
        {
          "value": "fit",
          "label": "Fit (content width)"
        }
      ],
      "default": "fill",
      "info": "Fill creates equal width columns, Fit sizes columns based on content"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Gap between columns",
      "default": 32
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Gap between content",
      "default": 16
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "image_picker",
      "id": "column_1_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "column_1_heading",
      "label": "Heading",
      "default": "Column 1"
    },
    {
      "type": "richtext",
      "id": "column_1_text",
      "label": "Text",
      "default": "<p>Add your content here</p>"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "image_picker",
      "id": "column_2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "column_2_heading",
      "label": "Heading",
      "default": "Column 2"
    },
    {
      "type": "richtext",
      "id": "column_2_text",
      "label": "Text",
      "default": "<p>Add your content here</p>"
    },
    {
      "type": "header",
      "content": "Column 3"
    },
    {
      "type": "image_picker",
      "id": "column_3_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "column_3_heading",
      "label": "Heading",
      "default": "Column 3"
    },
    {
      "type": "richtext",
      "id": "column_3_text",
      "label": "Text",
      "default": "<p>Add your content here</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#4a3c31"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4a3c31"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 14,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 24
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Three column layout"
    }
  ]
}
{% endschema %}
