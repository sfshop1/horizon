{% doc %}
  @prompt
    Give me an announcement slider that lets me do 3 announcements per slide with a small image 
    
    Give me a text size options and alignment with text colors and background colors.  
    
    Give me a layout percentage and let me do page or full 
    
    Give me a heigh adjustment 
    
    Give me the option to crop the images to a circle and also allow links to click on , I only need 3 announcments and I want to put the image in front of the text.  Also, when I click full width it's not the entirety it leaves white space on the sides 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-slider-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
  }

  .ai-announcement-slider__wrapper-{{ ai_gen_id }} {
    position: relative;
    height: {{ block.settings.slider_height }}px;
    background-color: {{ block.settings.background_color }};
    {% if block.settings.layout_width == 'page' %}
      max-width: 1200px;
      margin: 0 auto;
    {% endif %}
  }

  .ai-announcement-slider__track-{{ ai_gen_id }} {
    display: flex;
    height: 100%;
    transition: transform 0.5s ease;
  }

  .ai-announcement-slider__slide-{{ ai_gen_id }} {
    min-width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.item_spacing }}px;
    {% if block.settings.layout_width == 'page' %}
      padding: 20px;
    {% else %}
      padding: 20px 40px;
    {% endif %}
  }

  .ai-announcement-slider__item-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-announcement-slider__image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    flex-shrink: 0;
    overflow: hidden;
    {% if block.settings.crop_circle %}
      border-radius: 50%;
    {% endif %}
  }

  .ai-announcement-slider__image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-announcement-slider__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-announcement-slider__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-announcement-slider__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .ai-announcement-slider__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0;
  }

  .ai-announcement-slider__link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    flex: 1;
  }

  .ai-announcement-slider__link-{{ ai_gen_id }}:hover .ai-announcement-slider__image-wrapper-{{ ai_gen_id }} {
    opacity: 0.8;
  }

  .ai-announcement-slider__controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 2;
  }

  .ai-announcement-slider__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.text_color }};
    opacity: 0.3;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .ai-announcement-slider__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-announcement-slider__nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.text_color }};
    color: {{ block.settings.background_color }};
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .ai-announcement-slider__nav-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-announcement-slider__nav-{{ ai_gen_id }}--prev {
    left: 20px;
  }

  .ai-announcement-slider__nav-{{ ai_gen_id }}--next {
    right: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-slider__slide-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 20px;
      padding: 20px;
    }

    .ai-announcement-slider__item-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: center;
    }

    .ai-announcement-slider__link-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-announcement-slider__nav-{{ ai_gen_id }} {
      width: 32px;
      height: 32px;
    }

    .ai-announcement-slider__nav-{{ ai_gen_id }}--prev {
      left: 10px;
    }

    .ai-announcement-slider__nav-{{ ai_gen_id }}--next {
      right: 10px;
    }
  }
{% endstyle %}

<announcement-slider-{{ ai_gen_id }}
  class="ai-announcement-slider-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-announcement-slider__wrapper-{{ ai_gen_id }}">
    <div class="ai-announcement-slider__track-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        <div class="ai-announcement-slider__slide-{{ ai_gen_id }}">
          {% liquid
            assign image_key = 'slide_' | append: i | append: '_image'
            assign text_key = 'slide_' | append: i | append: '_text'
            assign link_key = 'slide_' | append: i | append: '_link'
            
            assign item_image = block.settings[image_key]
            assign item_text = block.settings[text_key]
            assign item_link = block.settings[link_key]
          %}

          <div class="ai-announcement-slider__item-{{ ai_gen_id }}">
            {% if item_link != blank %}
              <a href="{{ item_link }}" class="ai-announcement-slider__link-{{ ai_gen_id }}">
                <div class="ai-announcement-slider__image-wrapper-{{ ai_gen_id }}">
                  {% if item_image %}
                    <img
                      src="{{ item_image | image_url: width: 200 }}"
                      alt="{{ item_text | escape }}"
                      loading="lazy"
                      width="200"
                      height="200"
                    >
                  {% else %}
                    <div class="ai-announcement-slider__image-placeholder-{{ ai_gen_id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                {% if item_text != blank %}
                  <div class="ai-announcement-slider__content-{{ ai_gen_id }}">
                    <p class="ai-announcement-slider__text-{{ ai_gen_id }}">{{ item_text }}</p>
                  </div>
                {% endif %}
              </a>
            {% else %}
              <div class="ai-announcement-slider__image-wrapper-{{ ai_gen_id }}">
                {% if item_image %}
                  <img
                    src="{{ item_image | image_url: width: 200 }}"
                    alt="{{ item_text | escape }}"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                {% else %}
                  <div class="ai-announcement-slider__image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              {% if item_text != blank %}
                <div class="ai-announcement-slider__content-{{ ai_gen_id }}">
                  <p class="ai-announcement-slider__text-{{ ai_gen_id }}">{{ item_text }}</p>
                </div>
              {% endif %}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    <button
      class="ai-announcement-slider__nav-{{ ai_gen_id }} ai-announcement-slider__nav-{{ ai_gen_id }}--prev"
      aria-label="Previous slide"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <button
      class="ai-announcement-slider__nav-{{ ai_gen_id }} ai-announcement-slider__nav-{{ ai_gen_id }}--next"
      aria-label="Next slide"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <div class="ai-announcement-slider__controls-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        <button
          class="ai-announcement-slider__dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          data-slide="{{ forloop.index0 }}"
          aria-label="Go to slide {{ forloop.index }}"
        ></button>
      {% endfor %}
    </div>
  </div>
</announcement-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnouncementSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.totalSlides = 3;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-announcement-slider__track-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-announcement-slider__dot-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-announcement-slider__nav-{{ ai_gen_id }}--prev');
        this.nextButton = this.querySelector('.ai-announcement-slider__nav-{{ ai_gen_id }}--next');

        this.setupEventListeners();
        this.startAutoplay();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => {
          this.goToSlide(this.currentSlide - 1);
          this.resetAutoplay();
        });

        this.nextButton.addEventListener('click', () => {
          this.goToSlide(this.currentSlide + 1);
          this.resetAutoplay();
        });

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            this.goToSlide(index);
            this.resetAutoplay();
          });
        });
      }

      goToSlide(index) {
        if (index < 0) {
          this.currentSlide = this.totalSlides - 1;
        } else if (index >= this.totalSlides) {
          this.currentSlide = 0;
        } else {
          this.currentSlide = index;
        }

        this.track.style.transform = `translateX(-${this.currentSlide * 100}%)`;

        this.dots.forEach((dot, i) => {
          if (i === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.goToSlide(this.currentSlide + 1);
        }, 5000);
      }

      resetAutoplay() {
        clearInterval(this.autoplayInterval);
        this.startAutoplay();
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('announcement-slider-{{ ai_gen_id }}', AnnouncementSlider{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Announcement slider",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_width",
