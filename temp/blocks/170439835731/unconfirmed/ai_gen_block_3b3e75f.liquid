{% doc %}
  @prompt
    create an announcement bar that lets you show 3 announcements at once including images, make sure that it automatically rotates on mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding }}px 0;
    overflow: hidden;
    position: relative;
  }

  .ai-announcement-bar__container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    position: relative;
  }

  .ai-announcement-bar__slider-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
  }

  .ai-announcement-bar__slide-{{ ai_gen_id }} {
    min-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.content_gap }}px;
    padding: 0 20px;
  }

  .ai-announcement-bar__image-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-announcement-bar__image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-announcement-bar__content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.content_gap }}px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ai-announcement-bar__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    text-align: center;
  }

  .ai-announcement-bar__link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
    font-size: {{ block.settings.text_size }}px;
  }

  .ai-announcement-bar__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-announcement-bar__controls-{{ ai_gen_id }} {
    display: none;
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    gap: 8px;
    z-index: 10;
  }

  .ai-announcement-bar__dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.text_color }};
    opacity: 0.3;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-announcement-bar__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (min-width: 750px) {
    .ai-announcement-bar__slider-{{ ai_gen_id }} {
      flex-wrap: nowrap;
    }

    .ai-announcement-bar__slide-{{ ai_gen_id }} {
      min-width: calc(100% / 3);
    }

    .ai-announcement-bar__controls-{{ ai_gen_id }} {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar__controls-{{ ai_gen_id }} {
      display: flex;
    }

    .ai-announcement-bar__image-{{ ai_gen_id }} {
      width: {{ block.settings.image_size | times: 0.8 }}px;
      height: {{ block.settings.image_size | times: 0.8 }}px;
    }

    .ai-announcement-bar__text-{{ ai_gen_id }},
    .ai-announcement-bar__link-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<announcement-bar-{{ ai_gen_id }}
  class="ai-announcement-bar-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-announcement-bar__container-{{ ai_gen_id }}">
    <div class="ai-announcement-bar__slider-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign announcement_enabled_key = 'announcement_' | append: i | append: '_enabled'
          assign announcement_image_key = 'announcement_' | append: i | append: '_image'
          assign announcement_text_key = 'announcement_' | append: i | append: '_text'
          assign announcement_link_text_key = 'announcement_' | append: i | append: '_link_text'
          assign announcement_link_url_key = 'announcement_' | append: i | append: '_link_url'

          assign announcement_enabled = block.settings[announcement_enabled_key]
          assign announcement_image = block.settings[announcement_image_key]
          assign announcement_text = block.settings[announcement_text_key]
          assign announcement_link_text = block.settings[announcement_link_text_key]
          assign announcement_link_url = block.settings[announcement_link_url_key]
        %}

        {% if announcement_enabled %}
          <div class="ai-announcement-bar__slide-{{ ai_gen_id }}">
            {% if announcement_image %}
              <div class="ai-announcement-bar__image-{{ ai_gen_id }}">
                <img
                  src="{{ announcement_image | image_url: width: 200 }}"
                  alt="{{ announcement_image.alt | escape }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              </div>
            {% endif %}

            <div class="ai-announcement-bar__content-{{ ai_gen_id }}">
              {% if announcement_text != blank %}
                <div class="ai-announcement-bar__text-{{ ai_gen_id }}">
                  {{ announcement_text }}
                </div>
              {% endif %}

              {% if announcement_link_text != blank and announcement_link_url != blank %}
                <a
                  href="{{ announcement_link_url }}"
                  class="ai-announcement-bar__link-{{ ai_gen_id }}"
                >
                  {{ announcement_link_text }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-announcement-bar__controls-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign announcement_enabled_key = 'announcement_' | append: i | append: '_enabled'
          assign announcement_enabled = block.settings[announcement_enabled_key]
        %}
        {% if announcement_enabled %}
          <button
            class="ai-announcement-bar__dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-index="{{ forloop.index0 }}"
            aria-label="Go to announcement {{ forloop.index }}"
          ></button>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</announcement-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnouncementBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slider = this.querySelector('.ai-announcement-bar__slider-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-announcement-bar__slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-announcement-bar__dot-{{ ai_gen_id }}');
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) * 1000;

        this.setupEventListeners();
        this.updateSlider();

        if (window.innerWidth < 750 && this.autoplay) {
          this.startAutoplay();
        }

        window.addEventListener('resize', () => {
          this.handleResize();
        });
      }

      setupEventListeners() {
        this.dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            this.currentIndex = parseInt(dot.dataset.index);
            this.updateSlider();
            if (this.autoplay) {
              this.resetAutoplay();
            }
          });
        });

        let touchStartX = 0;
        let touchEndX = 0;

        this.slider.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        });

        this.slider.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].screenX;
          this.handleSwipe(touchStartX, touchEndX);
        });
      }

      handleSwipe(startX, endX) {
        if (window.innerWidth >= 750) return;

        const swipeThreshold = 50;
        const diff = startX - endX;

        if (Math.abs(diff) > swipeThreshold) {
          if (diff > 0) {
            this.next();
          } else {
            this.previous();
          }
        }
      }

      next() {
        this.currentIndex = (this.currentIndex + 1) % this.slides.length;
        this.updateSlider();
      }

      previous() {
        this.currentIndex = (this.currentIndex - 1 + this.slides.length) % this.slides.length;
        this.updateSlider();
      }

      updateSlider() {
        if (window.innerWidth < 750) {
          this.slider.style.transform = `translateX(-${this.currentIndex * 100}%)`;

          this.dots.forEach((dot, index) => {
            if (index === this.currentIndex) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        } else {
          this.slider.style.transform = 'translateX(0)';
        }
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.next();
        }, this.autoplaySpeed);
      }

      resetAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.startAutoplay();
        }
      }

      handleResize() {
        this.updateSlider();

        if (window.innerWidth < 750 && this.autoplay && !this.autoplayInterval) {
          this.startAutoplay();
        } else if (window.innerWidth >= 750 && this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('announcement-bar-{{ ai_gen_id }}', AnnouncementBar{{ ai_gen_id }});
  })();
</script>

