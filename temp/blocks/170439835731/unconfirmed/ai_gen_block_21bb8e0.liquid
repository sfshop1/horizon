{% doc %}
  @prompt
    create a contact section that includes our phone number address and email and then a vertical section beside it, and embed Google maps into it with the address pinned to 63235 CR 31 Goshen, IN 46528
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-section-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding: 60px 20px;
    max-width: 1200px;
    margin: 0 auto;
    background-color: {{ block.settings.background_color }};
  }

  .ai-contact-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-contact-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px 0;
  }

  .ai-contact-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .ai-contact-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    color: {{ block.settings.icon_color }};
  }

  .ai-contact-details-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-contact-label-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-contact-value-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    margin: 0;
  }

  .ai-contact-value-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-contact-map-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 400px;
    border-radius: {{ block.settings.map_border_radius }}px;
    overflow: hidden;
    border: {{ block.settings.map_border_width }}px solid {{ block.settings.map_border_color }};
  }

  .ai-contact-map-{{ ai_gen_id }} iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-section-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 40px 20px;
    }

    .ai-contact-map-{{ ai_gen_id }} {
      min-height: 300px;
    }
  }
{% endstyle %}

<div class="ai-contact-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-info-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-contact-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.phone != blank %}
      <div class="ai-contact-item-{{ ai_gen_id }}">
        <div class="ai-contact-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </div>
        <div class="ai-contact-details-{{ ai_gen_id }}">
          <p class="ai-contact-label-{{ ai_gen_id }}">Phone</p>
          <a href="tel:{{ block.settings.phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' }}" class="ai-contact-value-{{ ai_gen_id }}">{{ block.settings.phone }}</a>
        </div>
      </div>
    {% endif %}

    {% if block.settings.email != blank %}
      <div class="ai-contact-item-{{ ai_gen_id }}">
        <div class="ai-contact-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
        <div class="ai-contact-details-{{ ai_gen_id }}">
          <p class="ai-contact-label-{{ ai_gen_id }}">Email</p>
          <a href="mailto:{{ block.settings.email }}" class="ai-contact-value-{{ ai_gen_id }}">{{ block.settings.email }}</a>
        </div>
      </div>
    {% endif %}

    {% if block.settings.address != blank %}
      <div class="ai-contact-item-{{ ai_gen_id }}">
        <div class="ai-contact-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </div>
        <div class="ai-contact-details-{{ ai_gen_id }}">
          <p class="ai-contact-label-{{ ai_gen_id }}">Address</p>
          <p class="ai-contact-value-{{ ai_gen_id }}">{{ block.settings.address }}</p>
        </div>
      </div>
    {% endif %}
  </div>

  <div class="ai-contact-map-{{ ai_gen_id }}">
    {% if block.settings.map_embed_url != blank %}
      {{ block.settings.map_embed_url }}
    {% else %}
      <div style="display: flex; align-items: center; justify-content: center; height: 100%; background-color: #f4f4f4; color: #666; text-align: center; padding: 20px;">
        <p>Add your Google Maps embed code in the block settings</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Contact with map",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in touch"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "(555) 123-4567"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "contact@example.com"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "63235 CR 31 Goshen, IN 46528"
    },
    {
      "type": "header",
      "content": "Google Maps"
    },
    {
      "type": "html",
      "id": "map_embed_url",
      "label": "Map embed code",
      "info": "Paste the full iframe embed code from Google Maps"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4a3c31"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#c1272d"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#c1272d"
    },
    {
      "type": "range",
      "id": "map_border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Map border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "map_border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Map border width",
      "default": 0
    },
    {
      "type": "color",
      "id": "map_border_color",
      "label": "Map border color",
      "default": "#e6e6e6"
    }
  ],
  "presets": [
    {
      "name": "Contact with map"
    }
  ]
}
{% endschema %}
