{% doc %}
  @prompt
    can you make a copy of the existing product card with product image, product title, price and then put a Remaing: # stock badge on top of the product image and show a Pre-order badge on top of the image if invetory is <=0
{% enddoc %}
```liquid
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-card-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .ai-product-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-product-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-card-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-product-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-product-card-badges-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.badge_spacing }}px;
    left: {{ block.settings.badge_spacing }}px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 2;
  }

  .ai-product-card-badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 12px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 600;
    border-radius: {{ block.settings.badge_border_radius }}px;
    white-space: nowrap;
  }

  .ai-product-card-badge-stock-{{ ai_gen_id }} {
    background-color: {{ block.settings.stock_badge_bg }};
    color: {{ block.settings.stock_badge_text }};
  }

  .ai-product-card-badge-preorder-{{ ai_gen_id }} {
    background-color: {{ block.settings.preorder_badge_bg }};
    color: {{ block.settings.preorder_badge_text }};
  }

  .ai-product-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }

  .ai-product-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-product-card-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 500;
    margin-top: auto;
  }

  .ai-product-card-price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-left: 8px;
    font-size: {{ block.settings.price_font_size | times: 0.9 }}px;
  }
{% endstyle %}

<a
  href="{{ block.settings.product.url }}"
  class="ai-product-card-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-card-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.product.featured_image %}
      <img
        src="{{ block.settings.product.featured_image | image_url: width: 600 }}"
        alt="{{ block.settings.product.featured_image.alt | escape }}"
        loading="lazy"
        width="600"
        height="600"
        class="ai-product-card-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-product-card-image-placeholder-{{ ai_gen_id }}">
        {{ 'product-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if block.settings.product %}
      {% liquid
        assign inventory = block.settings.product.selected_or_first_available_variant.inventory_quantity
        assign show_stock_badge = false
        assign show_preorder_badge = false

        if block.settings.show_stock_badge and inventory > 0 and inventory <= block.settings.stock_threshold
          assign show_stock_badge = true
        endif

        if block.settings.show_preorder_badge and inventory <= 0
          assign show_preorder_badge = true
        endif
      %}

      {% if show_stock_badge or show_preorder_badge %}
        <div class="ai-product-card-badges-{{ ai_gen_id }}">
          {% if show_preorder_badge %}
            <span class="ai-product-card-badge-{{ ai_gen_id }} ai-product-card-badge-preorder-{{ ai_gen_id }}">
              {{ block.settings.preorder_text }}
            </span>
          {% endif %}

          {% if show_stock_badge %}
            <span class="ai-product-card-badge-{{ ai_gen_id }} ai-product-card-badge-stock-{{ ai_gen_id }}">
              {{ block.settings.stock_text | replace: '[count]', inventory }}
            </span>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}
  </div>

  <div class="ai-product-card-content-{{ ai_gen_id }}">
    {% if block.settings.product %}
      <h3 class="ai-product-card-title-{{ ai_gen_id }}">
        {{ block.settings.product.title }}
      </h3>

      <div class="ai-product-card-price-{{ ai_gen_id }}">
        {{ block.settings.product.price | money }}
        {% if block.settings.product.compare_at_price > block.settings.product.price %}
          <span class="ai-product-card-price-compare-{{ ai_gen_id }}">
            {{ block.settings.product.compare_at_price | money }}
          </span>
        {% endif %}
      </div>
    {% else %}
      <h3 class="ai-product-card-title-{{ ai_gen_id }}">Product title</h3>
      <div class="ai-product-card-price-{{ ai_gen_id }}">$0.00</div>
    {% endif %}
  </div>
</a>

{% schema %}
{
  "name": "Product card",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Stock badge"
    },
    {
      "type": "checkbox",
      "id": "show_stock_badge",
      "label": "Show remaining stock badge",
      "default": true
    },
    {
      "type": "range",
      "id": "stock_threshold",
      "min": 1,
      "max": 50,
      "step": 1,
      "label": "Show when stock is at or below",
      "default": 10
    },
    {
      "type": "text",
      "id": "stock_text",
      "label": "Stock badge text",
      "default": "Remaining: [count]",
      "info": "Use [count] to display the inventory quantity"
    },
    {
      "type": "color",
      "id": "stock_badge_bg",
      "label": "Background",
      "default": "#FFA500"
    },
    {
      "type": "color",
      "id": "stock_badge_text",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Pre-order badge"
    },
    {
      "type": "checkbox",
      "id": "show_preorder_badge",
      "label": "Show pre-order badge",
      "default": true,
      "info": "Displays when inventory is 0 or less"
    },
    {
      "type": "text",
      "id": "preorder_text",
      "label": "Pre-order badge text",
      "default": "Pre-order"
    },
    {
      "type": "color",
      "id": "preorder_badge_bg",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "preorder_badge_text",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Badge style"
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 12
    },
    {
      "type": "range",
      "id": "badge_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 4
    },
    {
      "type": "range",
      "id": "badge_spacing",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Spacing from edge",
      "default": 12
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Content padding",
      "default": 16
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 16
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#4a3c31"
    },
    {
      "type": "range",
      "id": "price_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Price size",
      "default": 14
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#4a3c31"
    }
  ],
  "presets": [
    {
      "name": "Product card"
    }
  ]
}
{% endschema %}
```