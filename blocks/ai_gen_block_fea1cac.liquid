{% doc %}
  @prompt
    can you use this code and help me make an announcments slider 
    
    {{ 'custom-announcement-slider.css' | asset_url | stylesheet_tag }}
    {{ 'custom-announcement-slider.js' | asset_url | script_tag }}
    
    <div class="announcement-slider-wrapper" style="width: {{ section.settings.layout_width }}%; margin: 0 auto;">
      <div class="announcement-slider" id="slider-{{ section.id }}" style="height: {{ section.settings.height }}px;">
        <div class="slider-track">
          {%- for block in section.blocks limit: section.settings.num_slides -%}
            <div class="slider-slide" style="
              background-color: {{ block.settings.slide_bg_color }};
              text-align: {{ block.settings.text_align }};
            ">
              {%- for i in (1..3) -%}
                {%- assign ann = block.settings['announcement' | append: i] -%}
                {%- if ann.text != blank -%}
                  <div class="announcement-item" style="color: {{ ann.text_color }};">
                    {%- if ann.image != blank -%}
                      <div class="ann-image-wrapper">
                        <img src="{{ ann.image | image_url: width: 80 }}" 
                             alt="{{ ann.image.alt | escape }}" 
                             class="ann-image {% if block.settings.crop_circle %}circle{% endif %}"
                             loading="lazy">
                      </div>
                    {%- endif -%}
                    <div class="ann-content">
                      <p class="ann-text" style="font-size: {{ section.settings.text_size }};">{{ ann.text | escape }}</p>
                      {%- if ann.link != blank -%}
                        <a href="{{ ann.link }}" class="ann-link">Learn More</a>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
        <!-- Navigation Dots -->
        <div class="slider-dots"></div>
        <!-- Arrows -->
        <button class="slider-arrow prev">‹</button>
        <button class="slider-arrow next">›</button>
      
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-slider-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
  }

  .ai-announcement-slider-{{ ai_gen_id }} {
    position: relative;
    height: {{ block.settings.slider_height }}px;
    overflow: hidden;
  }

  .ai-slider-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease-in-out;
    height: 100%;
  }

  .ai-slider-slide-{{ ai_gen_id }} {
    min-width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 16px;
    padding: 20px;
  }

  .ai-announcement-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 800px;
    width: 100%;
  }

  .ai-ann-image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-ann-image-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    object-fit: cover;
  }

  .ai-ann-image-{{ ai_gen_id }}.circle {
    border-radius: 50%;
  }

  .ai-ann-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-ann-text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.4;
  }

  .ai-ann-link-{{ ai_gen_id }} {
    text-decoration: underline;
    font-size: {{ block.settings.text_size | minus: 2 }}px;
    transition: opacity 0.3s ease;
  }

  .ai-ann-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-slider-dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 2;
  }

  .ai-slider-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.4;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-slider-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-slider-arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.arrow_bg_color }};
    color: {{ block.settings.arrow_color }};
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 24px;
    cursor: pointer;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .ai-slider-arrow-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-slider-arrow-{{ ai_gen_id }}.prev {
    left: 16px;
  }

  .ai-slider-arrow-{{ ai_gen_id }}.next {
    right: 16px;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-slider-{{ ai_gen_id }} {
      height: auto;
      min-height: {{ block.settings.slider_height | times: 0.8 }}px;
    }

    .ai-announcement-item-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: center;
    }

    .ai-slider-arrow-{{ ai_gen_id }} {
      width: 32px;
      height: 32px;
      font-size: 20px;
    }

    .ai-slider-arrow-{{ ai_gen_id }}.prev {
      left: 8px;
    }

    .ai-slider-arrow-{{ ai_gen_id }}.next {
      right: 8px;
    }
  }
{% endstyle %}

<announcement-slider-{{ ai_gen_id }}
  class="ai-announcement-slider-wrapper-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-announcement-slider-{{ ai_gen_id }}">
    <div class="ai-slider-track-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
          assign slide_bg_key = 'slide_' | append: i | append: '_bg_color'
          assign slide_text_key = 'slide_' | append: i | append: '_text_color'
          assign slide_text_align_key = 'slide_' | append: i | append: '_text_align'
          assign ann1_text_key = 'slide_' | append: i | append: '_ann1_text'
          assign ann1_link_key = 'slide_' | append: i | append: '_ann1_link'
          assign ann1_image_key = 'slide_' | append: i | append: '_ann1_image'
          assign ann2_text_key = 'slide_' | append: i | append: '_ann2_text'
          assign ann2_link_key = 'slide_' | append: i | append: '_ann2_link'
          assign ann2_image_key = 'slide_' | append: i | append: '_ann2_image'
          assign ann3_text_key = 'slide_' | append: i | append: '_ann3_text'
          assign ann3_link_key = 'slide_' | append: i | append: '_ann3_link'
          assign ann3_image_key = 'slide_' | append: i | append: '_ann3_image'

          assign slide_enabled = block.settings[slide_enabled_key]
          assign slide_bg = block.settings[slide_bg_key]
          assign slide_text_color = block.settings[slide_text_key]
          assign slide_text_align = block.settings[slide_text_align_key]
        %}

        {% if slide_enabled %}
          <div
            class="ai-slider-slide-{{ ai_gen_id }}"
            style="background-color: {{ slide_bg }}; text-align: {{ slide_text_align }};"
            data-slide="{{ i }}"
          >
            {% liquid
              assign ann1_text = block.settings[ann1_text_key]
              assign ann1_link = block.settings[ann1_link_key]
              assign ann1_image = block.settings[ann1_image_key]
              assign ann2_text = block.settings[ann2_text_key]
              assign ann2_link = block.settings[ann2_link_key]
              assign ann2_image = block.settings[ann2_image_key]
              assign ann3_text = block.settings[ann3_text_key]
              assign ann3_link = block.settings[ann3_link_key]
              assign ann3_image = block.settings[ann3_image_key]
            %}

            {% if ann1_text != blank %}
              <div
                class="ai-announcement-item-{{ ai_gen_id }}"
                style="color: {{ slide_text_color }};"
              >
                {% if ann1_image != blank %}
                  <div class="ai-ann-image-wrapper-{{ ai_gen_id }}">
                    <img
                      src="{{ ann1_image | image_url: width: 160 }}"
                      alt="{{ ann1_image.alt | escape }}"
                      class="ai-ann-image-{{ ai_gen_id }} {% if block.settings.crop_circle %}circle{% endif %}"
                      loading="lazy"
                      width="{{ block.settings.image_size }}"
                      height="{{ block.settings.image_size }}"
                    >
                  </div>
                {% endif %}
                <div class="ai-ann-content-{{ ai_gen_id }}">
                  <p class="ai-ann-text-{{ ai_gen_id }}">{{ ann1_text }}</p>
                  {% if ann1_link != blank %}
                    <a
                      href="{{ ann1_link }}"
                      class="ai-ann-link-{{ ai_gen_id }}"
                      style="color: {{ slide_text_color }};"
                      >{{ block.settings.link_text }}</a
                    >
                  {% endif %}
                </div>
              </div>
            {% endif %}

            {% if ann2_text != blank %}
              <div
                class="ai-announcement-item-{{ ai_gen_id }}"
                style="color: {{ slide_text_color }};"
              >
                {% if ann2_image != blank %}
                  <div class="ai-ann-image-wrapper-{{ ai_gen_id }}">
                    <img
                      src="{{ ann2_image | image_url: width: 160 }}"
                      alt="{{ ann2_image.alt | escape }}"
                      class="ai-ann-image-{{ ai_gen_id }} {% if block.settings.crop_circle %}circle{% endif %}"
                      loading="lazy"
                      width="{{ block.settings.image_size }}"
                      height="{{ block.settings.image_size }}"
                    >
                  </div>
                {% endif %}
                <div class="ai-ann-content-{{ ai_gen_id }}">
                  <p class="ai-ann-text-{{ ai_gen_id }}">{{ ann2_text }}</p>
                  {% if ann2_link != blank %}
                    <a
                      href="{{ ann2_link }}"
                      class="ai-ann-link-{{ ai_gen_id }}"
                      style="color: {{ slide_text_color }};"
                      >{{ block.settings.link_text }}</a
                    >
                  {% endif %}
                </div>
              </div>
            {% endif %}

            {% if ann3_text != blank %}
              <div
                class="ai-announcement-item-{{ ai_gen_id }}"
                style="color: {{ slide_text_color }};"
              >
                {% if ann3_image != blank %}
                  <div class="ai-ann-image-wrapper-{{ ai_gen_id }}">
                    <img
                      src="{{ ann3_image | image_url: width: 160 }}"
                      alt="{{ ann3_image.alt | escape }}"
                      class="ai-ann-image-{{ ai_gen_id }} {% if block.settings.crop_circle %}circle{% endif %}"
                      loading="lazy"
                      width="{{ block.settings.image_size }}"
                      height="{{ block.settings.image_size }}"
                    >
                  </div>
                {% endif %}
                <div class="ai-ann-content-{{ ai_gen_id }}">
                  <p class="ai-ann-text-{{ ai_gen_id }}">{{ ann3_text }}</p>
                  {% if ann3_link != blank %}
                    <a
                      href="{{ ann3_link }}"
                      class="ai-ann-link-{{ ai_gen_id }}"
                      style="color: {{ slide_text_color }};"
                      >{{ block.settings.link_text }}</a
                    >
                  {% endif %}
                </div>
              </div>
            {% endif %}
