      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  Snippet: announcement-rotator (color-scheme + page-width aware)\n\n  Default behavior:\n  • Inherit the surrounding section’s color scheme (background & text).\n  • Use theme page width (var(--page-width) → settings.page_width).\n\n  Optional params (all optional):\n  - use_scheme: true/false (default true). When true, inherit colors from parent.\n  - color_scheme_class: string. If you want to force a scheme class (e.g. \"color-scheme-1\" or \"color-scheme\").\n  - bg / fg: hex/rgb. Only used when use_scheme is false.\n  - rotate_ms: number (ms), default 3500\n  - tint_icons: true/false (default false)\n  - text1, icon1, text2, icon2, text3, icon3\n\n  Example:\n  {% render 'announcement-rotator',\n     use_scheme: true,\n     text1: 'Welcome to our store', icon1: 'https://cdn.shopify.com/s/files/1/0674/3467/6307/files/sf_for_slider.png?v=1761415454',\n     text2: 'Pickup available',     icon2: '/files/pickup.svg',\n     text3: 'Shipping available',   icon3: '/files/shipping.svg'\n  %}\n{%- endcomment -%}\n\n{%- assign _use_scheme    = use_scheme | default: true -%}\n{%- assign _bg            = bg | default: '#0f172a' -%}\n{%- assign _fg            = fg | default: '#ffffff' -%}\n{%- assign _rotate_ms     = rotate_ms | default: 3500 -%}\n{%- assign _tint_icons    = tint_icons | default: false -%}\n{%- assign _text1         = text1 | default: 'Welcome to our store' -%}\n{%- assign _icon1         = icon1 | default: '' -%}\n{%- assign _text2         = text2 | default: 'Pickup available' -%}\n{%- assign _icon2         = icon2 | default: '' -%}\n{%- assign _text3         = text3 | default: 'Shipping available' -%}\n{%- assign _icon3         = icon3 | default: '' -%}\n{%- assign _scheme_class  = color_scheme_class | default: '' -%}\n\n{%- comment -%} unique id per render {%- endcomment -%}\n{%- assign _ann_id = 'ann-' | append: 'now' | date: '%s' -%}\n\n{%- comment -%} icon tint filter {%- endcomment -%}\n{%- if _tint_icons == true or _tint_icons == 'true' -%}\n  {%- assign _icon_filter = 'brightness(0) saturate(100%) invert(100%)' -%}\n{%- else -%}\n  {%- assign _icon_filter = 'none' -%}\n{%- endif -%}\n\n{%- comment -%}\n  Page width fallback:\n  • Prefer CSS var(--page-width) if the theme defines it.\n  • Else fallback to settings.page_width (px).\n{%- endcomment -%}\n{%- assign _page_width_px = settings.page_width | default: 1200 -%}\n{%- if _page_width_px and _page_width_px contains 'px' -%}\n  {%- assign _page_width_css = _page_width_px -%}\n{%- else -%}\n  {%- assign _page_width_css = _page_width_px | append: 'px' -%}\n{%- endif -%}\n\n{%- capture wrapper_classes -%}\nannouncement-rotator\n{%- if _scheme_class != blank -%} {{ _scheme_class }}{%- endif -%}\n{%- endcapture -%}\n\n<div id=\"{{ _ann_id }}\" class=\"{{ wrapper_classes | strip }}\">\n  <div class=\"ann-inner\" role=\"region\" aria-label=\"Store announcements\" aria-live=\"polite\">\n    {%- assign ann_items = '' | split: ',' | push: _text1 | push: _text2 | push: _text3 -%}\n    {%- assign ann_icons = '' | split: ',' | push: _icon1 | push: _icon2 | push: _icon3 -%}\n\n    {%- for t in ann_items -%}\n      {%- assign icon_src = ann_icons[forloop.index0] -%}\n      {%- if t != blank -%}\n        <div class=\"ann-item\" data-index=\"{{ forloop.index0 }}\" role=\"group\">\n          <span class=\"ann-icon\">\n            {%- if icon_src != blank -%}\n              <img src=\"{{ icon_src | escape }}\" alt=\"\" loading=\"lazy\" decoding=\"async\" width=\"18\" height=\"18\">\n            {%- endif -%}\n          </span>\n          <span class=\"ann-text\">{{ t }}</span>\n        </div>\n      {%- endif -%}\n    {%- endfor -%}\n  </div>\n\n  <style>\n    /* Color strategy:\n       - If use_scheme == true: inherit colors from surrounding section\n         (Custom Liquid section’s color scheme classes set CSS variables).\n       - Else: use explicit bg/fg with safe fallbacks.\n    */\n    #{{ _ann_id }}{\n      {% if _use_scheme %}\n        background: transparent; /* let parent section’s scheme show */\n        color: inherit;\n      {% else %}\n        background: {{ _bg }};\n        color: {{ _fg }};\n      {% endif %}\n      width: 100%;\n      font-size: 14px;\n    }\n\n    #{{ _ann_id }} .ann-inner{\n      /* Page width from theme variables with fallback to settings */\n      max-width: var(--page-width, {{ _page_width_css }});\n      margin: 0 auto;\n      padding: 88px 116px;\n      display: grid;\n      grid-template-columns: 1fr 1fr 1fr;\n      gap: 8px 16px;\n      align-items: center;\n    }\n\n    #{{ _ann_id }} .ann-item{\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      min-height: 28px;\n      line-height: 1.2;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n\n    #{{ _ann_id }} .ann-icon img{\n      width: 18px;\n      height: 18px;\n      object-fit: contain;\n      vertical-align: middle;\n      display: inline-block;\n      /* If inheriting scheme, use currentColor tint via CSS filter (optional) */\n      filter: {% if _use_scheme %}{{ _icon_filter }}{% else %}{{ _icon_filter }}{% endif %};\n    }\n\n    /* MOBILE: rotate one item at a time */\n    @media (max-width: 767px){\n      #{{ _ann_id }} .ann-inner{ grid-template-columns: 1fr; }\n      #{{ _ann_id }} .ann-item{ display: none; }\n      #{{ _ann_id }} .ann-item.is-active{ display: inline-flex; }\n    }\n\n    /* Reduced motion: disable rotation */\n    @media (prefers-reduced-motion: reduce){\n      #{{ _ann_id }} .ann-inner{ grid-template-columns: 1fr 1fr 1fr !important; }\n      #{{ _ann_id }} .ann-item{ display: inline-flex !important; }\n    }\n  </style>\n\n  <script>\n    (function(){\n      var root = document.getElementById('{{ _ann_id }}');\n      if(!root) return;\n\n      var items = Array.prototype.slice.call(root.querySelectorAll('.ann-item'));\n      if(!items.length) return;\n\n      var mql = window.matchMedia('(max-width: 767px)');\n      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n      var interval = {{ _rotate_ms | plus: 0 }};\n      var idx = 0, timer = null;\n\n      function applyActive(i){\n        for(var k=0;k<items.length;k++){\n          items[k].classList.toggle('is-active', k === i);\n        }\n      }\n\n      function start(){\n        if(reduced){ items.forEach(function(el){ el.classList.add('is-active'); }); return; }\n        if(!mql.matches){ items.forEach(function(el){ el.classList.add('is-active'); }); return; }\n        applyActive(idx);\n        clearInterval(timer);\n        timer = setInterval(function(){\n          idx = (idx + 1) % items.length;\n          applyActive(idx);\n        }, interval);\n      }\n\n      function stop(){ clearInterval(timer); timer = null; }\n\n      root.addEventListener('mouseenter', stop);\n      root.addEventListener('mouseleave', start);\n\n      if(mql.addEventListener){ mql.addEventListener('change', start); }\n      else if(mql.addListener){ mql.addListener(start); }\n\n      start();\n    })();\n  </script>\n</div>",
        "color_scheme": "scheme-5",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
