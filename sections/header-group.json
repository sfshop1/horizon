    "custom_liquid_Cr8VG3": {
      "type": "custom-liquid",
      "name": "announcement-rotator",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  Snippet: announcement-rotator \n\n  Goals:\n  • Looks like your example: single-row slide with circular icon + centered text.\n  • Container is 90% wide and centers; max width respects theme page width via var(--page-width, settings.page_width).\n  • Inherits surrounding section color scheme by default (use_scheme=true).\n  • Optional overrides for bg/fg, autoplay, interval, arrows.\n  • No external JS/CSS dependencies.\n\n  Example:\n  {% render 'announcement-rotator',\n     use_scheme: true,\n     autoplay: true,\n     interval_ms: 4000,\n     show_arrows: false,\n     arrow_color: '#121212',\n     text1: 'Local Pickup Now Available!',\n     icon1: '//slabaughfarms.com/cdn/shop/files/pickup_icon_...png',\n     text2: '<strong>Delivery</strong> on orders over $100',\n     icon2: '//slabaughfarms.com/cdn/shop/files/delivery_icon_...png',\n     text3: '<strong>WELCOME</strong> to Slabaugh Farms',\n     icon3: '//slabaughfarms.com/cdn/shop/files/sf_for_slider.png'\n  %}\n{%- endcomment -%}\n\n{%- assign _use_scheme   = use_scheme    | default: true -%}\n{%- assign _bg           = bg            | default: '#6b5436' -%}\n{%- assign _fg           = fg            | default: '#f5e8d3' -%}\n{%- assign _autoplay     = autoplay      | default: true -%}\n{%- assign _interval_ms  = interval_ms   | default: 3500 -%}\n{%- assign _show_arrows  = show_arrows   | default: false -%}\n{%- assign _arrow_color  = arrow_color   | default: '#121212' -%}\n{%- assign _tint_icons   = tint_icons    | default: false -%}\n\n{%- assign _text1        = text1 | default: 'Welcome to our store' -%}\n{%- assign _icon1        = icon1 | default: '' -%}\n{%- assign _text2        = text2 | default: 'Pickup available' -%}\n{%- assign _icon2        = icon2 | default: '' -%}\n{%- assign _text3        = text3 | default: 'Shipping available' -%}\n{%- assign _icon3        = icon3 | default: '' -%}\n\n{%- assign _epoch = 'now' | date: '%s' -%}\n{%- assign _ann_id = 'ann-' | append: _epoch -%}\n\n{%- if _tint_icons == true or _tint_icons == 'true' -%}\n  {%- assign _icon_filter = 'brightness(0) saturate(100%) invert(100%)' -%}\n{%- else -%}\n  {%- assign _icon_filter = 'none' -%}\n{%- endif -%}\n\n{%- assign _page_width_px = settings.page_width | default: 1200 -%}\n{%- if _page_width_px and _page_width_px contains 'px' -%}\n  {%- assign _page_width_css = _page_width_px -%}\n{%- else -%}\n  {%- assign _page_width_css = _page_width_px | append: 'px' -%}\n{%- endif -%}\n\n<div id=\"{{ _ann_id }}\" class=\"dp-announcements-slider\">\n  <div class=\"dp-sizer\">\n    <div class=\"dp-slider\" role=\"region\" aria-label=\"Store announcements\" aria-live=\"polite\">\n      {%- assign _items = '' | split: ',' -%}\n      {%- assign _icons = '' | split: ',' -%}\n      {%- assign _items = _items | push: _text1 | push: _text2 | push: _text3 -%}\n      {%- assign _icons = _icons | push: _icon1 | push: _icon2 | push: _icon3 -%}\n\n      {%- for t in _items -%}\n        {%- assign src = _icons[forloop.index0] -%}\n        {%- if t != blank -%}\n          <div class=\"dp-slide\">\n            <div class=\"dp-announcement\">\n              <div class=\"dp-announcement-content\">\n                <div class=\"dp-image dp-image--circle\">\n                  {%- if src != blank -%}\n                    <img src=\"{{ src | escape }}\" alt=\"\" loading=\"lazy\" decoding=\"async\" width=\"42\" height=\"42\">\n                  {%- else -%}\n                    <span class=\"dp-image__placeholder\" aria-hidden=\"true\"></span>\n                  {%- endif -%}\n                </div>\n                <div class=\"dp-text dp-rte\">\n                  {{ t }}\n                </div>\n              </div>\n            </div>\n          </div>\n        {%- endif -%}\n      {%- endfor -%}\n    </div>\n\n    {%- if _show_arrows -%}\n      <button class=\"dp-nav dp-prev\" aria-label=\"Previous announcement\" type=\"button\">\n        <svg class=\"dp-icon\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path d=\"M15.4 19.4L8 12l7.4-7.4 1.4 1.4L10.8 12l6 6-1.4 1.4z\"/></svg>\n      </button>\n      <button class=\"dp-nav dp-next\" aria-label=\"Next announcement\" type=\"button\">\n        <svg class=\"dp-icon\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path d=\"M8.6 4.6L16 12l-7.4 7.4-1.4-1.4 6-6-6-6 1.4-1.4z\"/></svg>\n      </button>\n    {%- endif -%}\n  </div>\n\n  <style>\n    /* Wrapper colors: inherit scheme or use provided bg/fg */\n    #{{ _ann_id }}{\n      {% if _use_scheme %}\n        background: transparent;\n        color: inherit;\n      {% else %}\n        background: {{ _bg }};\n        color: {{ _fg }};\n      {% endif %}\n      --arrow-color: {{ _arrow_color }};\n    }\n\n    /* Sizer = 90% width centered; max width honors theme page width */\n    #{{ _ann_id }} .dp-sizer{\n      width: 90%;\n      max-width: var(--page-width, {{ _page_width_css }});\n      margin: 0 auto;\n      padding-top: 5px;\n      padding-bottom: 5px;\n      position: relative;\n    }\n\n    /* Slider track */\n    #{{ _ann_id }} .dp-slider{\n      overflow: hidden;\n      position: relative;\n    }\n\n    /* Each slide takes full width; we animate the track via JS */\n    #{{ _ann_id }} .dp-slide{\n      width: 100%;\n      flex: 0 0 100%;\n      display: block;\n    }\n\n    #{{ _ann_id }} .dp-announcement{\n      height: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      background: transparent;\n    }\n\n    #{{ _ann_id }} .dp-announcement-content{\n      max-width: 95%;\n      margin: 0 auto;\n      display: flex;\n      flex-direction: row;\n      align-items: center;\n      gap: 20px;\n      color: {% if _use_scheme %}currentColor{% else %}{{ _fg }}{% endif %};\n      min-height: 42px;\n    }\n\n    #{{ _ann_id }} .dp-image{\n      overflow: hidden;\n      width: 42px;\n      height: 42px;\n      flex: 0 0 42px;\n    }\n    #{{ _ann_id }} .dp-image--circle{ border-radius: 50%; }\n    #{{ _ann_id }} .dp-image img{\n      width: 42px; height: 42px; object-fit: cover; display: block; filter: {{ _icon_filter }};\n    }\n    #{{ _ann_id }} .dp-image__placeholder{\n      width: 42px; height: 42px; display: block; border-radius: 50%; background: rgba(0,0,0,0.15);\n    }\n\n    #{{ _ann_id }} .dp-text{\n      text-align: left;\n      line-height: 1.4;\n      font-size: clamp(12px, 2.5vw, 14px);\n      /* Example’s color was #f5e8d3 — we inherit or use fg */\n      color: {% if _use_scheme %}currentColor{% else %}{{ _fg }}{% endif %};\n    }\n\n    /* Simple arrow buttons (optional) */\n    #{{ _ann_id }} .dp-nav{\n      position: absolute;\n      top: 50%;\n      transform: translateY(-50%);\n      width: 24px; height: 24px;\n      border: 0; background: transparent; padding: 0;\n      cursor: pointer;\n    }\n    #{{ _ann_id }} .dp-prev{ left: -28px; }\n    #{{ _ann_id }} .dp-next{ right: -28px; }\n    #{{ _ann_id }} .dp-icon path{ fill: var(--arrow-color); }\n\n    /* Mobile tweaks to match the example ratios a bit tighter */\n    @media (max-width: 480px){\n      #{{ _ann_id }} .dp-sizer{\n        width: 90%; max-width: 90%;\n        padding-top: 2px; padding-bottom: 2px;\n      }\n      #{{ _ann_id }} .dp-announcement-content{ gap: 1em; }\n      #{{ _ann_id }} .dp-prev{ left: -1.8em; }\n      #{{ _ann_id }} .dp-next{ right: -1.8em; }\n    }\n  </style>\n\n  <script>\n    (function(){\n      var root = document.getElementById('{{ _ann_id }}');\n      if(!root) return;\n\n      var track = root.querySelector('.dp-slider');\n      var slides = Array.prototype.slice.call(root.querySelectorAll('.dp-slide'));\n      if(!slides.length) return;\n\n      // Build a simple horizontal track\n      var inner = document.createElement('div');\n      inner.className = 'dp-track';\n      inner.style.display = 'flex';\n      inner.style.willChange = 'transform';\n      inner.style.transition = 'transform 400ms ease';\n      while(track.firstChild){ inner.appendChild(track.firstChild); }\n      track.appendChild(inner);\n\n      var index = 0;\n      var count = slides.length;\n      var autoplay = {{ _autoplay | json }};\n      var interval = {{ _interval_ms | plus: 0 }};\n      var timer = null;\n\n      function go(i){\n        index = (i + count) % count;\n        var x = -index * 100;\n        inner.style.transform = 'translateX(' + x + '%)';\n      }\n\n      function start(){\n        if(!autoplay) return;\n        stop();\n        timer = setInterval(function(){ go(index + 1); }, Math.max(1500, interval));\n      }\n      function stop(){\n        if(timer){ clearInterval(timer); timer = null; }\n      }\n\n      // Buttons (optional)\n      var prev = root.querySelector('.dp-prev');\n      var next = root.querySelector('.dp-next');\n      if(prev){ prev.addEventListener('click', function(){ stop(); go(index - 1); start(); }); }\n      if(next){ next.addEventListener('click', function(){ stop(); go(index + 1); start(); }); }\n\n      // Pause on hover for desktop\n      root.addEventListener('mouseenter', stop);\n      root.addEventListener('mouseleave', start);\n\n      // React on resize (keep current index)\n      window.addEventListener('resize', function(){ go(index); });\n\n      // Reduced motion: disable autoplay\n      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n      if(reduced) autoplay = false;\n\n      // init\n      go(0);\n      start();\n    })();\n  </script>\n</div>",
        "color_scheme": "scheme-5",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
