{%- comment -%}
  {
    "pack_name": "Breadcrumbs",
    "pack_author": "Design Packs",
    "license": "© Design Packs. All rights reserved. This code is protected by copyright law and may not be reproduced, distributed, or used without explicit permission from the author. Shopify complies with the Digital Millennium Copyright Act (DMCA) and responds to claims of copyright infringement using DMCA procedures, which could result in the termination of your Shopify account.",
  }
{%- endcomment -%}

{% comment %} Security Code - hides section when app uninstalled {% endcomment %}
{%- unless content_for_header contains 'design_packs_file.js' -%}
  {%- if request.design_mode -%}
    <div class="dsgn-pck__no-app-warning">
      <div class="dsgn-pck__no-app-warning-background"></div>
      <div class="dsgn-pck__no-app-warning-text dsgn-pck__rte">
        <p>
          <strong>WARNING!</strong> This premium section will not display properly without an active subscription for
          <a href="https://apps.shopify.com/design-packs" target="_blank" rel="noopener nofollow">Design Packs</a>. If you need
          any support please email <a href="mailto:info@design-packs.com" target="_blank" rel="noopener">info@design-packs.com</a> with
          your questions.
        </p>
      </div>
    </div>
  {%- endif -%}
  {%- break -%}
{%- endunless -%}

{%- comment -%} Assign: Preview section js fix {%- endcomment -%}
{%- assign section_id = section.id | replace: '+', '' | replace: '=', '' -%}

{%- comment -%} Layout: has user entered measurement value into max-width field? {%- endcomment -%}
{%- if section.settings.max_width contains 'px' or section.settings.max_width contains '%' -%}
  {%- assign max_width = section.settings.max_width -%}
{%- else -%}
  {%- assign max_width = section.settings.max_width | append: 'px' -%}
{%- endif -%}

{%- comment -%} Text: custom font_picker values {%- endcomment -%}
{%- capture font_settings_list -%}
  {{ section.settings.main_font | font_face: font_display: 'swap' }}~
  {{ section.settings.main_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}~
  {{ section.settings.main_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}~
  {{ section.settings.main_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}~
{%- endcapture -%}
{%- assign font_array = font_settings_list | split: '~' -%}

{%- capture minify -%}
  {%- comment -%} CSS {%- endcomment -%}
  <style>
    {%- if section.settings.override_theme_font != blank -%}
      {%- for font in font_array -%}
        {%- unless font contains 'error' -%}{{ font }}{%- endunless -%}
      {%- endfor -%}
      .DP--{{ section_id }} {
    --main-font: {{ section.settings.main_font.family }}, {{ section.settings.main_font.fallback_families }};
    --main-font-weight: {{ section.settings.main_font.weight }};
    --main-font-style: {{ section.settings.main_font.style }};
  }
    {%- endif -%}

    .DP--{{ section_id }} {
      margin-bottom: {{ section.settings.outer_margin }}px;
      margin-top: {{ section.settings.outer_margin }}px;
    }

    .DP--{{ section_id }} .dsgn-pck__sizer {
      padding-top: {{ section.settings.inner_padding }}px;
      padding-bottom: {{ section.settings.inner_padding }}px;
      width: {{ section.settings.base_width }}%;
      max-width: {{ max_width }};
    }

    .DP--{{ section_id }} .dsgn-pck__breadcrumbs,
    .DP--{{ section_id }} .dsgn-pck__breadcrumbs a {
      color: {{ section.settings.text_color }};
      font-size: calc(var(--dp-g-body-size, var(--dp-body-size, 18px)) * {{ section.settings.text_size | times: 0.008 }});
      {%- if section.settings.override_theme_font != blank -%}
      font-family: var(--main-font);
      font-weight: var(--main-font-weight);
      font-style: var(--main-font-style);
      {%- endif -%}
    }

    .DP--{{ section_id }} .dsgn-pck__divider {
      display: inline-block;
      margin: 0 4px;
      color: {{ section.settings.divider_color }};
    }

    .DP--{{ section_id }} .dsgn-pck__parent-link {
      text-decoration: underline;
    }

    .DP--{{ section_id }} .dsgn-pck__current-page-name {
      font-weight: bold;
    }

    /* Landscape phones and down */
    @media (max-width: 480px) {
      .DP--{{ section_id }} .dsgn-pck__sizer {
        min-width: 70%;
        padding-top: {{ section.settings.inner_padding | divided_by: 2 }}px;
        padding-bottom: {{ section.settings.inner_padding | divided_by: 2 }}px;
      }

      {%- if section.settings.mobile_custom_css != blank -%}
        {%- assign mobile_custom_declarations = section.settings.mobile_custom_css | split: '}' -%}
        {%- for declaration in mobile_custom_declarations -%}
          {%- if declaration contains '{' -%}
            #DP--{{ section_id }} {{ declaration }} }
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    }
  </style>

  {%- comment -%} HTML {%- endcomment -%}
  <section id="DP--{{ section_id }}" class="DP--{{ section_id }} dsgn-pck__section">
    <div class="dsgn-pck__sizer">
      <nav class="dsgn-pck__breadcrumbs dsgn-pck__text-alignment-{{ section.settings.text_alignment }}" role="navigation" aria-label="breadcrumbs">
        {% if section.settings.show_home_link %}
          <a class="dsgn-pck__home-link dsgn-pck__parent-link" href="{{ routes.root_url }}" title="{{ section.settings.home_text }}">{{ section.settings.home_text }}</a>
            <span class="dsgn-pck__divider" aria-hidden="true">{% if section.settings.show_divider %}{{ section.settings.divider_text }}{% endif %}</span>
        {% endif %}
        {% if section.settings.show_parent_collections %}
          {% if template.name == 'product' %}
            {% if section.settings.collection_list == blank or section.settings.collection_list.size == 0 %}
              {% if collection %}
                <a href="{{ collection.url }}" title="{{ collection.title | escape }}" class="dsgn-pck__collection-link dsgn-pck__parent-link">{{ collection.title }}</a>
                <span class="dsgn-pck__divider" aria-hidden="true">{% if section.settings.show_divider %}{{ section.settings.divider_text }}{% endif %}</span>
              {% else %}
                <a href="{{ routes.all_products_collection_url }}" title="{{ section.settings.all_products_text }}" class="dsgn-pck__collection-link dsgn-pck__parent-link">{{ section.settings.all_products_text }}</a>
                <span class="dsgn-pck__divider" aria-hidden="true">{% if section.settings.show_divider %}{{ section.settings.divider_text }}{% endif %}</span>
              {% endif %}
              {% for collection in collections %}
                {% if collection[1].products contains product %}
                  <a class="dsgn-pck__collection-link dsgn-pck__parent-link" href="{{ collection[1].url }}" title="{{ collection[1].title }}">{{ collection[1].title }}</a>
                  <span class="dsgn-pck__divider" aria-hidden="true">{% if section.settings.show_divider %}{{ section.settings.divider_text }}{% endif %}</span>
                  {% break %}
                {% endif %}
              {% endfor %}
            {% else %}
              {% for collection in section.settings.collection_list %}
                <a class="dsgn-pck__collection-link dsgn-pck__parent-link" href="{{ collection.url }}" title="{{ collection.title }}">{{ collection.title }}</a>
                <span class="dsgn-pck__divider" aria-hidden="true">{% if section.settings.show_divider %}{{ section.settings.divider_text }}{% endif %}</span>
              {% endfor %}
            {% endif %}
          {% else %}
            {% for collection in section.settings.collection_list %}
              <a class="dsgn-pck__collection-link dsgn-pck__parent-link" href="{{ collection.url }}" title="{{ collection.title }}">{{ collection.title }}</a>
              <span class="dsgn-pck__divider" aria-hidden="true">{% if section.settings.show_divider %}{{ section.settings.divider_text }}{% endif %}</span>
            {% endfor %}
          {% endif %}
        {% endif %}
        {%- if section.settings.show_current_page_name -%}
          {%- if section.settings.custom_page_name != blank -%}
            {%- assign current_page_name = section.settings.custom_page_name -%}
          {%- else -%}
            {%- capture current_page_name %}
              {%- if template.name == 'product' -%}
                {{- product.title -}}
              {%- elsif template.name == 'collection' -%}
                {{- collection.title -}}
              {%- elsif template.name == 'page' -%}
                {{- page.title -}}
              {%- endif -%}
            {%- endcapture -%}
          {%- endif -%}
          <span class="dsgn-pck__current-page-name">{{- current_page_name -}}</span>
        {% endif %}
      </nav>
    </div>
  </section>
    {% assign breadcrumb_position = 1 %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {%- assign comma_needed = false -%}
        {%- if section.settings.show_home_link -%}
          {
            "@type": "ListItem",
            "position": {{ breadcrumb_position }},
            "name": "{{ section.settings.home_text | default: 'Home' }}",
            "item": "{{ shop.url }}/"
          }
          {%- assign breadcrumb_position = breadcrumb_position | plus: 1 -%}
          {%- assign comma_needed = true -%}
        {%- endif -%}
        {%- if section.settings.show_parent_collections -%}
          {% if collection %}
            {%- if comma_needed -%},{%- endif -%}
            {
              "@type": "ListItem",
              "position": {{ breadcrumb_position }},
              "name": "{{ collection.title | strip }}",
              "item": "{{ shop.url }}{{ collection.url }}"
            }
            {%- assign breadcrumb_position = breadcrumb_position | plus: 1 -%}
            {%- assign comma_needed = true -%}
          {% else %}
            {%- if comma_needed -%},{%- endif -%}
            {
              "@type": "ListItem",
              "position": {{ breadcrumb_position }},
              "name": "{{ section.settings.all_products_text }}",
              "item": "{{ shop.url }}{{ routes.all_products_collection_url }}"
            }
            {%- assign breadcrumb_position = breadcrumb_position | plus: 1 -%}
            {%- assign comma_needed = true -%}
          {% endif %}
          {%- for collection in section.settings.collection_list -%}
            {%- if comma_needed -%},{%- endif -%}
            {
              "@type": "ListItem",
              "position": {{ breadcrumb_position }},
              "name": "{{ collection.title | strip }}",
              "item": "{{ shop.url }}{{ collection.url }}"
            }
            {%- assign breadcrumb_position = breadcrumb_position | plus: 1 -%}
            {%- assign comma_needed = true -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if section.settings.show_current_page_name -%}
          {%- if comma_needed -%},{%- endif -%}
          {
            "@type": "ListItem",
            "position": {{ breadcrumb_position }},
            "name": "{{ section.settings.custom_page_name | default: current_page_name | strip }}",
            "item": "{{ shop.url }}{{ request.original_url | default: request.path | default: '/' }}"
          }
        {%- endif -%}
      ]
    }
    </script>
{%- endcapture -%}
{{ minify | strip_newlines }}

{% schema %}
{
  "name": "Breadcrumbs",
  "class": "DP__breadcrumbs",
  "limit": 1,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_home_link",
      "label": "Show home link",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.show_home_link }}",
      "type": "text",
      "id": "home_text",
      "label": "Home text",
      "default": "Home"
    },
    {
      "type": "checkbox",
      "id": "show_parent_collections",
      "label": "Show collections",
      "default": true,
      "info": "If no collections are selected below, the breadcrumbs will show the 'All Products' link. Or if on product page, the parent collection will be shown."
    },
    {
      "type": "text",
      "id": "all_products_text",
      "label": "'All products' text",
      "default": "All Products"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Collections",
      "info": "Use a metafield to show different collections for different products/pages. [Learn more](https://design-packs.gitbook.io/docs/fundamentals/section-settings/breadcrumbs-with-metafields)"
    },
    {
      "type": "checkbox",
      "id": "show_current_page_name",
      "label": "Show current page name",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.show_current_page_name }}",
      "type": "text",
      "id": "custom_page_name",
      "label": "Custom page name",
      "info": "Leave blank to use the current page name."
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider symbol",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.show_divider }}",
      "type": "text",
      "id": "divider_text",
      "label": "Divider symbol",
      "default": "/"
    },
    {
      "visible_if": "{{ section.settings.show_divider }}",
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "✏️ Text appearance"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 80,
      "max": 150,
      "step": 5,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "🎨 Design"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "🖼 Layout"
    },
    {
      "type": "range",
      "id": "base_width",
      "label": "Size",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 95,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "max_width",
      "label": "Maximum width",
      "placeholder": "eg. 1200px",
      "info": "Sets width constraint for content."
    },
    {
      "type": "range",
      "id": "inner_padding",
      "label": "Inner padding",
      "info": "Only applies to top and bottom.",
      "min": 0,
      "max": 100,
      "default": 20,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "🚨 Advanced"
    },
    {
      "type": "liquid",
      "id": "custom_css",
      "label": "CSS"
    },
    {
      "type": "liquid",
      "id": "mobile_custom_css",
      "label": "Mobile CSS",
      "info": "Applied on screens less than 480px."
    },
    {
      "type": "checkbox",
      "id": "override_theme_font",
      "label": "Override default theme font",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.override_theme_font == true }}",
      "type": "font_picker",
      "id": "main_font",
      "label": "Text",
      "default": "sans-serif"
    }
  ],
  "presets": [
    {
      "name": "Breadcrumbs 🎒",
      "category": "* Design Packs * Navigation"
    }
  ]
}
{% endschema %}
