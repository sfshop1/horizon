<section id="subscription-box-builder"
         class="subscription-builder"
         style="
           padding: {{ section.settings.padding }}px 0;
           max-width: {{ section.settings.max_width }}px;
           margin: auto;
         ">

  <!-- Summary Bar -->
  <div class="builder-summary">
    <div class="summary-stats">
      <div>Total Items: <span id="total-items">0</span></div>
      <div>Total Weight: <span id="total-weight">0</span> lbs</div>
    </div>
  </div>

  <!-- Items Table -->
  <table class="builder-table">
    <thead>
      <tr>
        <th>Item</th>
        <th>Description</th>
        <th>Thickness</th>
        <th>Approx. Weight</th>
        <th colspan="2">Qty</th>
      </tr>
    </thead>

    <tbody id="subscription-items">
      <!-- JS will inject subscription‑eligible items here -->
    </tbody>
  </table>

  <!-- Hidden JSON Output -->
  <textarea id="bundle-json" style="display:none;"></textarea>

  <!-- Complete Subscription Button -->
  <button id="complete-subscription" class="complete-btn">
    Complete Subscription
  </button>

</section>

<script src="{{ 'subscription-builder.js' | asset_url }}" defer></script>

<style>
.subscription-builder {
  font-family: sans-serif;
}

/* Summary Bar */
.builder-summary {
  background: #f7f7f7;
  padding: 16px;
  margin-bottom: 20px;
  border-radius: 6px;
}

.summary-stats {
  display: flex;
  gap: 40px;
  font-size: 18px;
}

/* Table */
.builder-table {
  width: 100%;
  border-collapse: collapse;
}

.builder-table th,
.builder-table td {
  padding: {{ section.settings.column_gap }}px;
  border-bottom: 1px solid #ddd;
}

/* Qty Buttons */
.qty-minus,
.qty-plus {
  padding: 6px 10px;
  background: #eee;
  border: 1px solid #ccc;
  cursor: pointer;
}

/* Complete Button */
.complete-btn {
  margin-top: 20px;
  padding: 14px 20px;
  background: #6B5436;
  color: white;
  border: none;
  cursor: pointer;
  font-size: 18px;
  border-radius: 6px;
}
</style>

{% schema %}
{
  "name": "Subscription Box Builder",
  "settings": [
    {
      "type": "range",
      "id": "padding",
      "label": "Section Padding (Top & Bottom)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Builder Max Width (px)",
      "min": 600,
      "max": 1600,
      "step": 20,
      "default": 900
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column Spacing (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12
    },
    {
      "type": "text",
      "id": "storefront_token",
      "label": "Storefront API Token"
    },
    {
      "type": "text",
      "id": "shop_domain",
      "label": "Shop Domain (yourshop.myshopify.com)"
    }
  ],
  "presets": [
    {
      "name": "Subscription Box Builder"
    }
  ]
}
{% endschema %}
