    },
    {
      "type": "dpb_-_buttons"
    },
    {
      "type": "dpb_-_inset_image"
    },
    {
      "type": "dpb_-_video"
    },
    {
      "type": "dpb_-_icons"
    },
    {
      "type": "dpb_-_text"
    },
    {
      "type": "dpb_-_divider"
    },
    {
      "type": "dpb_-_spacer"
    },
    {
      "type": "_dpb_-_columns"
    },
    {
      "type": "_dpb_-_group"
