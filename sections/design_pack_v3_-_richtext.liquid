    },
    {
      "visible_if": "{{ section.settings.enable_mobile_styles == true }}",
      "type": "range",
      "id": "mobile_margin_bottom",
      "label": "Mobile margin bottom",
      "min": 0,
      "max": 100,
      "default": 0,
      "unit": "px"
    },
    {
      "visible_if": "{{ section.settings.enable_mobile_styles == true }}",
      "type": "select",
      "id": "mobile_padding_type",
      "label": "Padding",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "padding_range_sliders",
          "label": "Range"
        },
        {
          "value": "custom_padding",
          "label": "Custom"
        }
      ],
      "default": "default"
    },
    {
      "visible_if": "{{ section.settings.enable_mobile_styles == true and section.settings.mobile_padding_type == 'custom_padding' }}",
      "type": "text",
      "id": "mobile_padding",
      "label": "Custom padding",
      "default": "0px 0px 0px 0px",
      "info": "Enter padding in the format: top right bottom left. Example: 10px 20px 30px 40px [Learn more](https://developer.mozilla.org/en-US/docs/Web/CSS/padding)"
    },
    {
      "visible_if": "{{ section.settings.enable_mobile_styles == true and section.settings.mobile_padding_type == 'padding_range_sliders' }}",
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "visible_if": "{{ section.settings.enable_mobile_styles == true and section.settings.mobile_padding_type == 'padding_range_sliders' }}",
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "visible_if": "{{ section.settings.enable_mobile_styles == true and section.settings.mobile_padding_type == 'padding_range_sliders' }}",
      "type": "range",
      "id": "mobile_padding_left",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "visible_if": "{{ section.settings.enable_mobile_styles == true and section.settings.mobile_padding_type == 'padding_range_sliders' }}",
      "type": "range",
      "id": "mobile_padding_right",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "🚨 Advanced"
    },
    {
      "type": "liquid",
      "id": "custom_css",
      "label": "CSS"
    },
    {
      "type": "liquid",
      "id": "mobile_custom_css",
      "label": "Mobile CSS",
      "info": "Applied on screens less than 480px."
    },
    {
      "type": "text",
      "id": "anchor_id",
